/**
 * Title of 'New Organisms' report, db table 'tpps_ncbi_taxonomy' and validation regex variables.
 */
function tpps_update_7124() {
  variable_set('tpps_report_new_organisms_title', 'New Organisms');
  // Late fix of manually added changes on live site.
  if (empty(variable_get('tpps_js_debug_mode'))) {
    variable_set('tpps_js_debug_mode', ['quickDebugMode' => 'quickDebugMode']);
  }
  // Create new db table.
  $table_name = 'tpps_ncbi_taxonomy';
  if (!db_table_exists($table_name)) {
    if ($table_schema = tpps_schema()[$table_name]) {
      $transaction = db_transaction();
      try {
        db_create_table($table_name, $table_schema);
      }
      catch (\Exception $e) {
        $transaction->rollback();
        throw $e;
      }
    }
  }
  // Set regex for validation.
  if (empty(variable_get('tpps_validation_regex_doi'))) {
    variable_set('tpps_validation_regex_doi', '/^10\.\d{4,9}[\-._;()\/:A-Za-z0-9]+$/');
    variable_set('tpps_validation_regex_organism_name', '/^10\.\d{4,9}[\-._;()\/:A-Za-z0-9]+$/');
    variable_set('tpps_validation_regex_single_space', '/^[^\s]*\s[^\s]*$/');
  }

  cache_clear_all();
}

