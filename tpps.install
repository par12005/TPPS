  variable_set('tpps_report_organism_genus_title', 'Organism Genus List');
  variable_set('tpps_report_organism_species_title', 'Organism Species List');
  variable_set('tpps_report_organism_all_title', 'All Organism List');

  // Misc.
  variable_set('tpps_validation_regex_doi', '/10\.\d{4,9}[\-._;()\/:A-Za-z0-9]+/');
  variable_set('tpps_cron_cors_proxy_keep_alive_frequency', '*/15 * * * *');
  variable_set('tpps_page_1_doi_lookup_debug_mode', FALSE);

  // GBIF Reports.
  variable_set('tpps_report_organism_gbif_all_title', 'All organisms and their GBIF Taxonomy Ids');
  variable_set('tpps_report_organism_gbif_missing_title', 'Organisms without GBIF Taxonomy Id');
  variable_set('tpps_report_organism_split_title', 'Organism Name Split');
  variable_set('tpps_report_organism_taxonomy_title', "Organism's Taxonomy");
  variable_set('tpps_report_organism_synonym_list_title', "Organism Synonym List");
  // Invisible setting.
  variable_set('tpps_organism_gbif_use_cache', TRUE);
  variable_set('tpps_organism_ncbi_use_cache', TRUE);

  variable_set(
    'tpps_validation_regex_organism_name',
    '/^[A-Za-z]+(?:\s+[A-Za-z]+)+(?:\s+(?:subsp\.|spp\.|subspecies|var\.|varieta|variety|f\.|forma|form)\s+[A-Za-z]+)*(?:\s+(?:\([A-Za-z.]+\)\s+)?[A-Za-z.]+(?:\s+ex\s+[A-Za-z.]+)?(?:,\s+\d{4})?)?$/'
  );
  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // Remove outdated variables.
  variable_del('tpps_rest_api_log_show_response');
  variable_del('tpps_rest_api_log_show_request');
  variable_del('tpps_rest_api_log_type');
  variable_del('tpps_page_1_dryad_api_url');
  variable_del('tpps_page_1_cache_ajax_responses');
  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // Create new db table.
  $table_list = [
    PublicationDoi::TABLE,
    GoogleScholar::TABLE,
    DataDryad::TABLE,
    PubMed::TABLE,
    GbifSpeciesApi::TABLE,
  ];
  foreach ($table_list as $table_name) {
    if (!db_table_exists($table_name)) {
      if ($table_schema = tpps_schema()[$table_name]) {
        $transaction = db_transaction();
        try {
          db_create_table($table_name, $table_schema);
        }
        catch (\Exception $e) {
          $transaction->rollback();
          throw $e;
        }
      }
    }
  }

  // Replace cvterm id for organism's infraspecific name.
  // Emily: cvterm_id 50375 is preferable as it uses the EDAM ontology
  // rather than local.
  if (!empty(OrganismSynonym::CVTERM_ID)) {
    db_update('chado.organismprop')
      ->fields(['type_id' => OrganismSynonym::CVTERM_ID])
      ->condition('type_id', 2780)
      ->execute();
  }

  cache_clear_all();
}
