function tpps_update_7128() {
  variable_del('tpps_zenodo_prefix');
  variable_set('tpps_zenodo_debug_mode', FALSE);
  variable_set('tpps_report_zenodo_submissions_title', 'Zenodo Submissions');
  variable_set('tpps_report_zenodo_depositions_title', 'Zenodo Depositions');
  variable_set('tpps_report_organism_ncbi_all_title', 'All organisms and their NCBI Taxonomy Ids');
  variable_set('tpps_report_organism_ncbi_missing_title', 'Organisms without NCBI Taxonomy Id');

  variable_set('tpps_report_synonym_list_title', 'Phenotype Synonyms');
  variable_set('tpps_zenodo_host_greedy_search', FALSE);
  variable_set('tpps_zenodo_api_request_delay', 100);
  // Rest API Settings.
  variable_set('tpps_rest_api_log_type', []);
  variable_set('tpps_rest_api_timeout', 30);
  variable_set('tpps_rest_api_log_show_request', FALSE);
  variable_set('tpps_rest_api_log_show_response', FALSE);
  variable_set('tpps_rest_api_max_execution_time', 5000);

  // Rename variable.
  if (
    !is_null(variable_get('tpps_zenodo_sandbox_key', NULL))
    && is_null(variable_set('tpps_zenodo_access_token_live', NULL))
  ) {
    variable_set('tpps_zenodo_access_token_live',
      variable_get('tpps_zenodo_sandbox_key', '')
    );
  }
  variable_del('tpps_zenodo_sandbox_key');
  variable_del('tpps_admin_panel_show_execution_time');
  variable_del('tpps_admin_panel_cache_new_species_list');

  // Change name of the report title variables.
  // Format: old => new.
  $mapping = [
    'tpps_report_missing_files_title' => 'tpps_report_missing_files_title',
    'tpps_report_variable_list_title' => 'tpps_report_variable_list_title',
    'tpps_report_no_synonym_title' => 'tpps_report_synonym_missing_title',
    'tpps_report_unit_warning_title' => 'tpps_report_synonym_unit_warning_title',
    'tpps_report_organism_list_title' => 'tpps_report_organism_list_title',
    'tpps_report_new_organisms_title' => 'tpps_report_organism_new_title',
    'tpps_report_order_family_not_exist_title' => 'tpps_report_organism_order_family_not_exist_title',
    'tpps_report_doi_duplicates_title' => 'tpps_report_doi_duplicates_title',
    'tpps_report_missing_doi_title' => 'tpps_report_doi_missing_title',
    'tpps_report_zenodo_depositions_title' => 'tpps_report_zenodo_deposition_title',
    'tpps_report_imported_studies_title' => 'tpps_report_submission_imported_title',
    'tpps_report_zenodo_submissions_title' => 'tpps_report_submission_zenodo_title',
    'tpps_report_submissions_all_files_title' => 'tpps_report_submission_file_all_title',
    'tpps_report_submissions_without_files_title' => 'tpps_report_submission_file_none_title',
    'tpps_report_submissions_missing_files_title' => 'tpps_report_submission_file_missing_title',
  ];

  foreach ($mapping as $old => $new) {
    variable_set($new, variable_get($old));
    variable_del($old);
  }
  // Configure permissions.
  $permissions = ['administer zenodo', 'view own zenodo deposits'];
  foreach (['administrator', 'Curation'] as $role_name) {
    $role = user_role_load_by_name($role_name);
    user_role_grant_permissions($role->rid, $permissions);
  }
  $permissions = ['view own zenodo deposits'];
  foreach (['authenticated user'] as $role_name) {
    $role = user_role_load_by_name($role_name);
    user_role_grant_permissions($role->rid, $permissions);
  }
}

