<?php

/**
 * @file
 * Main file for 'custom_blocks'.
 */

/**
 * Removed blocks by block id.
 *
 * @param mixed $bid_list
 *   Single block id or list of block ids.
 */
function custom_blocks_remove($bid_list) {
  if (!is_array($bid_list)) {
    $bid_list = [$bid_list];
  }
  db_delete('block')
    ->condition('bid', $bid_list, 'IN')
    ->execute();
  db_delete('block_custom')
    ->condition('bid', $bid_list, 'IN')
    ->execute();
}

/**
 * Implements hook_page_build().
 */
function custom_blocks_page_build(&$page) {
  $path = drupal_get_path_alias(current_path());
  if (strpos($path, 'nafgs') === 0) {
    // Add JS (Block 25) to pages: /nafgs, /nafgs/*.
    drupal_add_js(drupal_get_path('module', 'custom_blocks') . '/js/nafgs.js');
  }
}

/**
 * Implements hook_block_info().
 */
function custom_blocks_block_info() {
  // Block 16.
  $blocks['featured_treegenes_resources'] = [
    'info' => t('Featured TreeGenes Resources'),
    'cache' => DRUPAL_CACHE_GLOBAL,
    // 'Properties' doesn't work on module installation.
    'properties' => [
      'administrative' => FALSE,
      'weight' => 0,
      // Enable by default.
      'status' => 1,
      // Place in Content region.
      'region' => 'content',
      'visibility' => BLOCK_VISIBILITY_LISTED,
      'pages' => '<front>',
      // Users cannot control block's visibility.
      'custom' => 0,
    ],
  ];

  // Block 28. Disabled (not used).
  $blocks['treegenes_data_summary_widget'] = [
    'info' => t('TreeGenes Data Summary Widget (Splash)'),
    'cache' => DRUPAL_CACHE_GLOBAL,
    'properties' => [
      'administrative' => FALSE,
      'weight' => 0,
      'status' => 0,
      'visibility' => BLOCK_VISIBILITY_LISTED,
      'pages' => '<front>',
      // Users cannot control block's visibility.
      'custom' => 0,
    ],
  ];

  // Block 22.
  $blocks['publication_details_page_title_and_header'] = [
    'info' => t('Page Title and Title Header for Publication Details'),
    'cache' => DRUPAL_CACHE_GLOBAL,
    'properties' => [
      'administrative' => FALSE,
      'weight' => 0,
      'status' => 1,
      'region' => 'content',
      'visibility' => BLOCK_VISIBILITY_LISTED,
      'pages' => 'Publication/*',
      // Users cannot control block's visibility.
      'custom' => 0,
    ],
  ];

  return $blocks;
}

/**
 * Implements hook_block_view().
 *
 * This hook generates the contents of the blocks.
 */
function custom_blocks_block_view($delta = '') {
  $block = [];
  switch ($delta) {
    case 'featured_treegenes_resources':
      $block['subject'] = t('Featured TreeGenes Resources');
      $block['content'] = custom_block_get_16_body();
      break;

    case 'treegenes_data_summary_widget':
      $block['subject'] = NULL;
      $block['content'] = custom_block_get_28_body();
      break;

    case 'publication_details_page_title_and_header':
      $block['subject'] = NULL;
      $block['content'] = custom_block_get_22_body();
      break;

  }
  return $block;
}

/**
 * Builds content of the block #16 ('Featured TreeGenes Resources'.
 *
 * @return string
 *   Returns rendered HTML-table.
 */
function custom_block_get_16_body() {
  $rows = [
    [
      //'<div class="card">
      //  <img typeof="foaf:Image" class="img-responsive" src="' . url('sites/default/files/uploads/galaxy-ss.jpg') . '" />
      //  <h3 class="thumb-title">' . l(t('Galaxy'), 'http://treegenes.cam.uchc.edu/') . '</h3>
      //</div>',
      '<div class="card">
        <img typeof="foaf:Image" class="img-responsive"
          src="' . url('sites/default/files/uploads/ctree.png') . '" />
        <h3 class="thumb-title">' . l(t('CartograPlant'), 'https://treegenesdb.org/cartograplant') . '</h3>
      </div>',
      '<div class="card">
        <img typeof="foaf:Image" class="img-responsive" src="' . url('sites/default/files/uploads/jbrowse-ss.jpg') . '" />
        <h3 class="thumb-title">' . l(t('JBrowse'), 'jbrowse') . '</h3>
      </div>',
    ],
  ];
  $output = theme('table', [
