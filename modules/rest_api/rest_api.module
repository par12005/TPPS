<?php

/**
 * @file
 * Manages REST API.
 */

/**
 * Implements hook_menu().
 */
function rest_api_menu() {
  $items['admin/config/services/rest_api'] = [
    'title' => 'REST API',
    'description' => 'REST API Settings',
    'page callback' => 'drupal_get_form',
    'page arguments' => ['rest_api_settings_form'],
    'access arguments' => ['administer rest_api'],
    'file' => 'admin/rest_api.inc',
  ];
  return $items;
}

/**
 * Implements hook_permission().
 */
function rest_api_permission() {
  return [
    'administer rest_api' => [
      'title' => t('Administer REST API'),
      'description' => t('Configure REST API.'),
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function rest_api_theme() {
  return [
    // Rest API.
    'request_report_link' => [
      'variables' => [
        'request_id' => NULL,
        'title' => NULL,
      ],
      'file' => 'theme/misc.inc',
    ],
    'response_report_link' => [
      'variables' => [
        'response_id' => NULL,
        'title' => NULL,
      ],
      'file' => 'theme/misc.inc',
    ],
    // Other.
    'http_code' => [
      'variables' => [
        'code' => NULL,
      ],
      'file' => 'theme/misc.inc',
    ],
    'http_method' => [
      'variables' => [
        'method' => NULL,
      ],
      'file' => 'theme/misc.inc',
    ],
    'response_body' => [
      'variables' => [
        'title' => NULL,
        'body' => NULL,
        'content_type' => NULL,
      ],
      'file' => 'theme/misc.inc',
    ],
  ];
}

/**
 * Implements hook_cron().
 */
function rest_api_cron() {
  $retention_days = (int) variable_get('rest_api_log_retention_days', 30);
  if ($retention_days <= 0) {
    return;
  }

  $cutoff = REQUEST_TIME - ($retention_days * 86400);

  // Purge expired responses first in deterministic primary-key order.
  $expired_response_ids = db_select(RestApiResponse::TABLE, 'r')
    ->fields('r', ['response_id'])
    ->condition('created', $cutoff, '<')
    ->orderBy('response_id', 'ASC')
    ->range(0, 1000)
    ->execute()
    ->fetchCol();
  if (!empty($expired_response_ids)) {
    db_delete(RestApiResponse::TABLE)
      ->condition('response_id', $expired_response_ids, 'IN')
      ->execute();
  }

  // Purge old requests only when they have no remaining responses in
  // {rest_api_response} so active recurring endpoints are not deleted.
  $query = db_select(RestApiRequest::TABLE, 'req');
  $query->leftJoin(
    RestApiResponse::TABLE,
    'r',
    'req.request_id = r.request_id'
  );
  $expired_request_ids = $query
    ->fields('req', ['request_id'])
    ->condition('req.created', $cutoff, '<')
    ->isNull('r.response_id')
    ->orderBy('req.request_id', 'ASC')
    ->range(0, 1000)
    ->execute()
    ->fetchCol();
  if (!empty($expired_request_ids)) {
    db_delete(RestApiRequest::TABLE)
      ->condition('request_id', $expired_request_ids, 'IN')
      ->execute();
  }
}

/**
 * Builds a watchdog report link if the target report path exists.
 *
 * @param string $path_prefix
 *   Report route prefix.
 * @param int|string|null $id
 *   Record ID to link to.
 *
 * @return string|null
 *   Rendered HTML link if path is valid, or NULL otherwise.
 */
function _rest_api_watchdog_report_link($path_prefix, $id) {
  if (empty($id)) {
    return NULL;
  }
  $path = $path_prefix . $id;
  if (function_exists('drupal_valid_path') && drupal_valid_path($path)) {
    return l((string) $id, $path);
  }
  return NULL;
}

// ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

/**
 * Implements hook_rest_api_exception_alter().
 */
function rest_api_rest_api_exception_alter(&$message, array $context) {
  $response = $context['response'] ?? $context['body'] ?? NULL;
  if (is_array($response)) {
    if (!empty($response['description'])) {
      // Telegram Bot API error format:
      // {'ok': false, 'error_code': 400, 'description': '...'}.
      $message .= ' ' . $response['description'];
    }
    if (!empty($response['status'])) {
      if (!empty($response['message'])) {
        $message .= ' ' . $response['message'];
      }
      if (!empty($response['errors']) && is_array($response['errors'])) {
        foreach ($response['errors'] as $error) {
          if (!empty($error['field']) && !empty($error['messages'])) {
            $err_msgs = implode(' ', (array) $error['messages']);
            $message .= ' ' . $error['field'] . ': ' . $err_msgs;
          }
        }
      }
    }
  }
}

/**
 * Implements hook_rest_api_response_loaded().
 */
function rest_api_rest_api_response_loaded(array $context = []) {
  if (!variable_get('rest_api_debug_mode', FALSE)) {
    return;
  }
  if (!empty($context['request_id']) && !empty($context['response_id'])) {
    $msg = "Loaded existing response '@response_id' to request '@request_id'.";
    $params = [
      '@response_id' => $context['response_id'],
      '@request_id' => $context['request_id'],
    ];
    watchdog(
      'rest_api',
      $msg,
      $params,
      WATCHDOG_INFO,
      _rest_api_watchdog_report_link(
        'admin/reports/tpps/rest_api/response/body/',
        $context['response_id']
      )
    );
  }
}

/**
 * Implements hook_rest_api_request_started().
 */
function rest_api_rest_api_request_started(array $context = []) {
  $debug_mode = (bool) variable_get('rest_api_debug_mode', FALSE);
  $sanitized_context = RestApiRequest::sanitizeContext($context);
  if ($debug_mode) {
    $params = [
      '@dump' => var_export($sanitized_context, TRUE),
      '@function' => __FUNCTION__,
    ];
    watchdog(
      'rest_api',
      '@function: <pre>@dump</pre>',
      $params,
      WATCHDOG_DEBUG
    );
  }

  if (!empty($context['request_id'])) {
    return $context['request_id'];
  }

  if (!empty($context['log']) && variable_get('rest_api_use_log', TRUE)) {
    if (empty($context['hash'])) {
      $params = ['@function' => __FUNCTION__];
      watchdog(
        'rest_api',
        '@function: empty "hash".',
        $params,
        WATCHDOG_ERROR
      );
      return FALSE;
    }

    $request_id = RestApiRequest::save($sanitized_context);
    if ($debug_mode) {
      $report_id = $request_id ?: ($context['request_id'] ?? '');
      $message = !empty($request_id)
        ? "Rest API Request '@request_id' was saved."
        : "Rest API Request '@request_id' already exists.";
      $params = [
        '@request_id' => $report_id,
      ];
      watchdog(
        'rest_api',
        $message,
        $params,
        WATCHDOG_INFO,
        _rest_api_watchdog_report_link(
          'admin/reports/tpps/rest_api/request/single/',
          $report_id
        )
      );
    }

    return $request_id;
  }

  // Logging is not allowed.
  return NULL;
}

/**
 * Implements hook_rest_api_response_received().
 */
function rest_api_rest_api_response_received(array $context = []) {
  // Record requests whose processing takes a very long time even if DB logging
  // is disabled.
  $max_execution_time = variable_get('rest_api_max_execution_time', 5000);
  if (($context['duration'] ?? 0) >= $max_execution_time) {
    $request_id = $context['request_id'] ?? '';
    $message = "Processing request '@request_id' took too long: "
      . "@duration msec.";
    $params = [
      '@request_id' => $request_id ?: 'N/A',
      '@duration' => round($context['duration'], 2),
    ];
    watchdog(
      'rest_api',
      $message,
      $params,
      WATCHDOG_WARNING,
      _rest_api_watchdog_report_link(
        'admin/reports/tpps/rest_api/request/single/',
        $request_id
      )
    );
  }

  if (
    !variable_get('rest_api_use_log', TRUE)
    || !($context['log'] ?? TRUE)
  ) {
    return;
  }
  // No need to save response if request wasn't saved and has no request_id.
  if (empty($context['request_id'])) {
    return;
  }

  $response_id = RestApiResponse::save($context);
  if (!empty($response_id) && variable_get('rest_api_debug_mode', FALSE)) {
    $message = "Response '@response_id' to request '@request_id' was saved.";
    $params = [
      '@response_id' => $response_id,
      '@request_id' => $context['request_id'],
    ];
    watchdog(
      'rest_api',
      $message,
      $params,
      WATCHDOG_INFO,
      _rest_api_watchdog_report_link(
        'admin/reports/tpps/rest_api/response/body/',
        $response_id
      )
    );
  }
}
