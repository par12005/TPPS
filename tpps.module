/**
 * Checks if Form's Id is 'tppsc_main' or 'tpps_main'.
 *
 * @param array $form_state
 *   Drupal From API State array.
 *
 * @return bool
 *   Returns TRUE if given $form_state belongs to one on forms processed by
 *   this module ('tppsc_main' or 'tpps_main'). Returns FALSE otherwise.
 */
function tpps_is_main_form(array $form_state) {
  return in_array(
    $form_state['build_info']['form_id'] ?? NULL,
    ['tppsc_main', 'tpps_main']
  );
}

/**
 * Creates new submission object.
 *
 * How to use:
 * tpps_submission($a)->set(['status'], $status)->save();
 *
 * @param string $accession
 *   Submission Accession.
 *
 * @return object
 *   Returns Submission object or throw an exception if it's not found.
 *
 * @throws Exception
 *  When study wasn't found.
 */
function tpps_submission($accession = '') {
  // @TODO Make this variable global.
  $submission = new Submission();
  if ($accession) {
    $submission->accession = $accession;
    $submission->load();
    if ($submission->doesNotExist()) {
      throw new Exception(
        t('Submission @accession not found.', ['@accession' => $accession])
      );
    }
  }
  return $submission;
}

/**
 * Creates new Organism object.
 *
 * How to use:
 * tpps_organism($id)->name;
 * tpps_organism($id)->genus;
 * tpps_organism($id)->ncbiTaxonomyId;
 *
 * @param mixed $organism_key
 *   Organism Id or Name.
 *
 * @return object
 *   Returns Organism object or throw an exception if it's not found.
 */
function tpps_organism($organism_key = '') {
  $organism = new Organism($organism_key);
  if ($organism->doesNotExist()) {
    throw new Exception(
      t('Organism "@key" not found.', ['@key' => $organism_key])
    );
  }
  return $organism;
}

/**
 * Creates new PhenotypeManual object.
 *
 * How to use:
 * $form['phenotype'] = tpps_phenotype_manual()-build($id);
 *
 * @return object
 *   Returns object of the PhenotypeManual class.
 */
function tpps_phenotype_manual() {
  $phenotypeManual = new PhenotypeManual();
  return $phenotypeManual;
}

/**
 * Creates new PhenotypeMeta object.
 *
 * How to use:
 * $form['phenotype'] = tpps_phenotype_meta()-build($id);
 *
 * @return object
 *   Returns object of the PhenotypeManual class.
 *
 * @todo Minor. Merge with PhenotypeManual class and use 'Phenotype' name
 * but now it's overloaded and will be hard to search and use.
 */
function tpps_phenotype_meta() {
  $phenotypeMeta = new PhenotypeMeta();
  return $phenotypeMeta;
}

/**
 * Creates intance of the 'Submission' class.
 *
 * @param string $accession
 *   Submission Accession.
 *
 * @return object
 *   Returns created instance to allow method chaining.
 */
function tpps_submission_load($accession) {
  // @todo Minor. Use static caching.
  $submission = new Submission($accession);
  return $submission;
}

/**
 * Creates instance of the 'FormState' class.
 *
 * @param array $form_state
 *   Submission's Form State.
 *   See 'public.tpps_submission.submission_state' db table.
 *
 * @return object
 *   Returns created instance to allow method chaining.
 */
function tpps_form_state_load(array $form_state) {
  $formState = new FormState($form_state);
  return $formState;
}

// ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
// Zenodo Hooks.

/**
 * Implements hook 'zenodo_deposit_published'.
 */
function tpps_zenodo_deposit_published(array $data) {
  drupal_set_message(t('Zenodo Deposit was <strong>published</strong>.'));
}

/**
 * Implements hook 'zenodo_deposit_deleted'.
 */
function tpps_zenodo_deposit_deleted(array $data) {
  $message = t('Zenodo Deposit #@deposit_id was <strong>deleted</strong>.',
    ['@deposit_id' => $data['deposit_id']]
  );
  drupal_set_message($message);

  if (empty($deposition = $data['deposition'])) {
    if (!empty($data['deposit_id'])) {
      $deposition = ZenodoDeposit::retrieve($data);
    }
  }

  // Update Submission.
  if (empty($data['accession'])) {
    return;
  }
  $submission = new Submission($data['accession']);
  if ($submission->doesNotExist()) {
    return;
  }
  if (!empty($deposition)) {
    // Check if there is previous version.
    $version_list = ZenodoDeposit::getAllVersions(
      [
        // The other way to get 'coneptrecid':
        //$conceptrecid = $submission->getZenodoConceptRecordId();
        'conceptrecid' => $deposition['conceptrecid'] ?? NULL,
        'deposit_id' => $deposition['id'],
      ],
      $sort = 'mostrecent'
    );
    if (empty($version_list)) {
      // Was removed unpublished last version.
      $conceptrecid = NULL;
      $new_deposit_id = NULL;
      $message = t('Removed last unpublished version of Zenodo Deposition.');
    }
    else {
      $conceptrecid = $deposition['conceptrecid'];
      $new_deposit_id = $version_list[0]['id'];
      $message = t('Restored previous verion of the Zenodo Deposit: #@deposit_id.',
        ['@deposit_id' => $new_deposit_id]
      );
    }
    drupal_set_message($message);
    if ($deposition['id'] = $submission->getZenodoDepositId()) {
      // Unset exsisting Dataset DOI value.
      $submission->updateDatasetDoi(NULL);
      // WARNING: Be sure to save $submission.
      $submission->setZenodoConceptRecordId($conceptrecid, $save_on_change = FALSE);
      $submission->setZenodoDepositId($new_deposit_id, $save_on_change = FALSE);
      $submission->save();
      $message = t('Submission @accession was updated.',
        ['@accession' => $data['accession']]
      );
      drupal_set_message($message);
    }
  }
  // Clear cache.
  SubmissionCache::updateSingle($submission);
}

/**
 * Implements hook 'zenodo_deposit_before_create'.
 */
function tpps_zenodo_deposit_before_create(array $data) {
  // Get Dataset DOI.
  $submission = new Submission($data['accession']);
  if ($submission->doesNotExist()) {
    $message = t("Submission '@accession' wasn't found.", ['@accession' => $accession]);
    throw new Exception($message, 1001);
  }
  $dataset_doi = $submission->getDatasetDoi();
  // Check if Dataset DOI is empty and it could be overwritten.
  if (empty($dataset_doi) || variable_get('tpps_zenodo_overwrite_dataset_doi')) {
    return;
  }
  $message = t('Submission "@accession" has non-empty Dataset DOI (@dataset_doi).',
    ['@accession' => $data['accession'], '@dataset_doi' => $dataset_doi]
  );
  throw new Exception($message, 1002);
}

/**
 * Implements hook 'zenodo_deposit_created'.
 */
function tpps_zenodo_deposit_created(array $data) {
  if (empty($data['accession']) || empty($deposit_id = $data['response']['id'])) {
    return;
  }
  drupal_set_message(t('Zenodo Deposit was <strong>created</strong>.'));
  // Store Zenodo Deposit Id into TPPS Submission.
  $submission = new Submission($data['accession']);
  if ($submission->doesNotExist()) {
    $message = t("Submission '@accession' wasn't found.", ['@accession' => $accession]);
    drupal_set_message($message);
    return;
  }
  SubmissionCache::updateSingle($submission);
  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // Store DOI.
  $dataset_doi = $data['response']['metadata']['prereserve_doi']['doi'] ?? NULL;
  $submission->updateDatasetDoi($dataset_doi);
  // WARNING: Be sure to save $submission.
  $conceptrecid = $data['response']['conceptrecid'] ?? NULL;
  $submission->setZenodoConceptRecordId($conceptrecid, $save_on_change = FALSE);
  // Store Zenodo Deposit Id and save submission to DB.
  $submission->setZenodoDepositId($deposit_id, $save_on_change = FALSE);
  $submission->save();

  drupal_set_message(t(
    'Zenodo Deposit Id <strong>@deposit_id</strong> stored in submission.',
    ['@deposit_id' => $deposit_id]
  ));

  // Upload all files in Submission to Zenodo Deposit.
  // @TODO Minor. Use 'update' to be sure old files removed.
  $submission->actionAllFilesZenodo('create');
}

/**
 * Implements hook 'zenodo_deposit_updated'.
 *
 * @param array $data
 *   Request Data. Keys are:
 *   - 'deposit_id' int Required. Zenodo Deposit Id.
 *   - 'accession' string Required. TPPS Submission accession.
 *   - 'url' string Required. Zenodo API Endpoint URL.
 *   - 'payload' array Required. Request payload.
 *   - 'response' mixed Required. Zenodo API Response.
 */
function tpps_zenodo_deposit_updated(array $data) {
  drupal_set_message(t('Zenodo Deposit was <strong>updated</strong>.'));
}

/**
 * Alters data before requiest ZenodoDeposit::update() will be done.
 *
 * Note: Called before API Endpoint URL will be generated.
 *
 * @param array $data
 *   Data for Zenodo API request. Could be empty.
 *
 * @todo Minor. Allow to change all fields. Should edit-form be used?
 */
function tpps_zenodo_deposit_update_alter(array &$data = []) {
  // Validation.
  if (empty($data) || empty($data['accession'])) {
    return;
  }
  // Populate $data with actual data from the $submission.
  $submission = new Submission($data['accession']);
  if ($submission->doesExist()) {
    $data['payload']['metadata'] = $submission->buildZenodoDepositMetadata();
  }
}

/**
 * Alters data before requiest ZenodoDeposit::create() will be done.
 *
 * Note: Called before API Endpoint URL will be generated.
 *
 * @param array $data
 *   Data for Zenodo API request. Could be empty.
 *
 * @todo The same as tpps_zenodo_deposit_update_alter().
 */
function tpps_zenodo_deposit_create_alter(array &$data = []) {
  // Validation.
  if (empty($data) || empty($data['accession'])) {
    return;
  }
  // Populate $data with actual data from the $submission.
  $submission = new Submission($data['accession']);
  if ($submission->doesExist()) {
    $data['payload']['metadata'] = $submission->buildZenodoDepositMetadata();
  }
}

/**
 * Implements hook 'zenodo_deposit_host_changed'.
 */
function tpps_zenodo_deposit_host_changed($new_host) {
  // @TODO Minor. Add site settings to enable/disble those messages.
  drupal_set_message(
    t(
      'Zenodo Deposition was found on other Zenodo Host. It was temporary '
      . '(for this page only) changed to "@new_host".',
      ['@new_host' => $new_host]
    ),
    'warning'
  );
}

/**
 * Implements hook 'zenodo_deposit_validation_failed'.
 */
function tpps_zenodo_deposit_validation_failed(array $response) {
  // @TODO Minor. Add site settings to enable/disble those messages.
  if (!empty($response['status']) && !empty($response['message'])) {
    drupal_set_message(t('ZenodoDeposit Resource validation failed. '
      . '<br />Response: <strong>@code - @message</strong>'
      . '<br />Check if correct Zenodo server was used.',
      [
        '@code' => $response['status'],
        '@message' => $response['message'],
      ]
    ));
  }
  else {
    drupal_set_message(t('Zenodo Deposition not found.'));
  }
}

