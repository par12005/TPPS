/**
 * Implements hook 'submission_saved'.
 */
function tpps_submission_saved($submission) {
  if (variable_get('tpps_submission_log_save_event', FALSE)) {
    $message = 'Submission "@accession" was saved. !stack';
    $params = [
      '!stack' => TppsArray::print(
        debug_backtrace(!DEBUG_BACKTRACE_PROVIDE_OBJECT | DEBUG_BACKTRACE_IGNORE_ARGS, 10)
      ),
      '@accession' => $submission->accession,
    ];
    watchdog('tpps', $message, $params);
  }
  SubmissionCache::updateSingle($submission);

  if (variable_get('tpps_submission_clear_cache_on_save', FALSE)) {
    // @todo Very slow because Submission::save() calls many times per single
    // request. Implement single save event before enable clearing cache.
    tpps_cache_clear_all();
  }
}

/**
 * Clears TPPS_CACHE_BIN only.
 *
 * This function is required because not all 'cid' must be cleared.
 *
 * @param mixed $list
 *   Optional.
 *   List of cache items.
 * @param bool $force
 *   When TRUE then even reports which supports per row update will be created.
 */
function tpps_cache_clear_all($list = NULL, $force = FALSE) {
  $cache_bin = TPPS_CACHE_BIN ?? 'cache';
  if ($list == 'all' || (is_array($list) && empty($list))) {
    watchdog('tpps', 'Cleared all TPPS caches');
    cache_clear_all('*', $cache_bin, TRUE);
  }
  else {
    $list = is_null($list) ? tpps_cache_get_cid_list() : $list;
    if (empty($list)) {
      return;
    }
    foreach ($list as $cid) {
      watchdog('tpps', 'Cleared "@cid" cache.', ['@cid' => $cid]);
      cache_clear_all($cid, $cache_bin);
    }
  }
}

/**
 * Gets list of cid.
 *
 * @return array
 *   Returns list of cid used in TPPS_CACHE_BIN.
 */
function tpps_cache_get_cid_list() {
  return [
    // Checked:
    'tpps_synonym_list',
    'tpps_unit_list',
    // Custom list on TPPS Admin Panel.
    'tpps_admin_panel_cache_new_species_list',

    // Need to be checked:
    'tpps_report_doi_duplicates',
    'tpps_cv',
    'tpps_phenotype_field',
  ];
}

/**
 * Implements hook 'submission_purged'.
 */
function tpps_submission_purged($accession) {
  tpps_cache_clear_all();
  drupal_set_message(
    t("Submission @accession and it's files was removed and cache was cleared.",
      ['@accession' => $accession]
    )
  );
}

/**
 * Implements hook 'submission_version_downgraded'.
 *
 * Adds status message to watchdog.
 * Note: Downgrade doesn't mean update db records.
 *
 * @param mixed $context
 *   Necessary data.
 *   Required keys are: 'to_version', 'from_version', 'accession'.
 */
function tpps_submission_version_downgraded($context) {
  if (!variable_get('tpps_submission_version_log_downgrade', FALSE)) {
    return;
  }
  $message = 'Downgraded submission "@accession" from @from_version '
    . 'to @to_version version.';
  $params = [
    '@from_version' => $context['from_version'],
    '@to_version' => $context['to_version'],
    '@accession' => $context['accession'],
  ];
  watchdog('tpps', $message, $params, WATCHDOG_NOTICE);
}

/**
 * Implements hook 'submission_version_upgraded'.
 *
 * Adds status message to watchdog.
 * Note: Upgrade doesn't mean update db records.
 *
 * @param mixed $context
 *   Necessary data.
 *   Required keys are: 'to_version', 'from_version', 'accession'.
 */
function tpps_submission_version_upgraded($context) {
  if (!variable_get('tpps_submission_version_log_upgrade', FALSE)) {
    return;
  }
  $message = 'Upgraded submission "@accession" from @from_version '
    . 'to @to_version version.';
  $params = [
    '@from_version' => $context['from_version'],
    '@to_version' => $context['to_version'],
    '@accession' => $context['accession'],
  ];
  watchdog('tpps', $message, $params, WATCHDOG_NOTICE);
}

/**
 * Implements hook 'submission_cache_updated'.
 */
function tpps_submission_cache_updated() {
  if (variable_get('tpps_submission_cache_log_full_update', FALSE)) {
    $message = 'Submission Cache was fully updated. !stack';
    $stack = debug_backtrace(!DEBUG_BACKTRACE_PROVIDE_OBJECT | DEBUG_BACKTRACE_IGNORE_ARGS, 10);
    $params = [
      '!stack' => TppsArray::print($stack),
    ];
    watchdog('tpps', $message, $params, WATCHDOG_NOTICE);
  }
}

/**
 * Implements hook 'submission_cache_single_updated'.
 */
function tpps_submission_cache_single_updated($accession) {
  if (variable_get('tpps_submission_cache_log_single_update', FALSE)) {
    $message = 'Updated single item in Submission Cache: @accession. !stack';
    $stack = debug_backtrace(!DEBUG_BACKTRACE_PROVIDE_OBJECT | DEBUG_BACKTRACE_IGNORE_ARGS, 10);
    $params = [
      '@accession' => $accession,
      '!stack' => TppsArray::print($stack),
    ];
    watchdog('tpps', $message, $params, WATCHDOG_NOTICE);
  }
}

/**
