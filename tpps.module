  $items['api/organism/%/%'] = [
    // File Object with extra absolute path and URL for downloading.
    'title' => 'Organism Info',
    'page callback' => 'tpps_api_organism_info',
    // 2: Managed File Id.
    'page arguments' => [2, 3],
    'access callback' => 'tpps_api_access',
    'file' => 'api/organism/info.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  $items['api/organism/%'] = [
    // File Object with extra absolute path and URL for downloading.
    'title' => 'Organism Info',
    'page callback' => 'tpps_api_organism_info',
    // 2: Managed File Id.
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
    'file' => 'api/organism/info.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  // File API.
  $items['api/file/%file/info'] = [
    // File Object with extra absolute path and URL for downloading.
    'title' => 'File Info',
    'page callback' => 'tpps_api_file_info',
    // 2: Managed File Id.
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
    'file' => 'api/file/info.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  $items['api/file/%file/get'] = [
    'title' => "Download File",
    'page callback' => 'tpps_api_file_get',
    // 2: Managed File Id.
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
