 */
function tpps_hook_info() {
  // Move hook_theme() into tpps.theme.inc file.
  $hooks['theme'] = ['group' => 'theme'];
  return $hooks;
}

/**
 * Implements hook_forms().
 */
function tpps_forms() {
  $forms = [];
  $forms['submission_tag_form']['callback'] = 'FormCreateSubmissionTag::build';
  $forms['submission_tag_edit_form']['callback'] = 'FormEditSubmissionTag::build';
  $forms['submission_tag_remove_form']['callback'] = 'FormRemoveSubmissionTag::build';
  $forms['submission_remove_form']['callback'] = 'FormRemoveSubmission::build';
  return $forms;
}

/**
 * Implements hook 'submission_tag_linked'.
 *
 * Shows message to the end user.
 *
 * @param string $accession
 *   Submission accession. E.g., 'TGDR1234'.
 * @param int $tag_id
 *   Submission Tag Id.
 */
function tpps_submission_tag_linked($accession, $tag_id) {
  $params = [
    '@accession' => $accession,
    '@tag_id' => $tag_id,
    '@tag_name' => SubmissionTag::getName($tag_id),
  ];
  $message = t(
    'Tag "@tag_name" (#@tag_id) has been added to Submission "@accession".',
    $params
  );
  drupal_set_message($message);
}

/**
 * Implements hook 'submission_tag_unlinked'.
 *
 * Shows message to the end user.
 *
 * @param string $accession
 *   Submission accession. E.g., 'TGDR1234'.
 * @param int $tag_id
 *   Submission Tag Id.
 * @param string $result
 *   Status of the removement. Tags with ids 1 and 2 can't be removed and
 *   this case require additional processing.
 */
function tpps_submission_tag_unlinked($accession, $tag_id, $result = 'success') {
  $params = [
    '@accession' => $accession,
    '@tag_id' => $tag_id,
    '@tag_name' => SubmissionTag::getName($tag_id),
  ];
  if ($result == 'success') {
    $message = t(
      'Tag "@tag_name" (#@tag_id) has been removed from Submission "@accession".',
      $params
    );
  }
  elseif ($result == 'protected') {
    $message = t(
      'Tag "@tag_name" (#@tag_id) cannot be removed from Submission "@accession".',
      $params
    );
  }
  drupal_set_message($message);
}

/**
 * Implements hook 'file_removed'.
 *
 * @param object $file
 *   Drupal Managed File object.
 */
function tpps_file_removed($file) {
  if ($file) {
    $params = ['@file' => print_r($file, 1)];
    watchdog('tpps', 'Removed file: <pre>@file</pre>', $params);
  }
}

/**
 * Implements alter-hook 'rest_api_response_hash_generation'.
 *
 * @param array $context
 *   Response meta data for hash generation.
 *   See RestApiResponse::generateHash().
 */
function tpps_rest_api_response_hash_generation_alter(array &$context) {
  $method = 'alterResponseHashGeneration';
  $list = array_merge(
    PublicationDoi::getApiList(),
    PublicationDoi::getSerpList()
  );
  foreach ($list as $class_name) {
    if (!method_exists($class_name, $method)) {
      continue;
    }
    $context = call_user_func_array([$class_name, $method], [$context]);
  }
}

/**
 * Implements hook_admin_paths().
 *
 * Enable admin theme for custom menu items.
 */
function tpps_admin_paths() {
  $paths = [
    'tpps/batch/ncbi/taxonomy_id' => TRUE,
    'tpps/batch/gbif/taxonomy_id' => TRUE,
    'tpps/batch/gbif/synonym' => TRUE,
  ];
  return $paths;
}
