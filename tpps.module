    // 1st placeholder is an accession. E.g., 'TGDRxxxx'.
    'page arguments' => [1],
    'access callback' => 'tpps_access',
    'access arguments' => ['access content'],
    'type' => MENU_NORMAL_ITEM,
    'file' => 'pages/dataset_doi/create.inc',
  ];
  $items['tpps/%/dataset-doi/files'] = [
    'title' => 'Dataset DOI File List',
    'page callback' => 'drupal_get_form',
    // #2 is an accession. E.g., 'TGDRxxxx'.
    'page arguments' => ['tpps_dataset_doi_files_form', 1],
    'access callback' => 'tpps_access',
    'access arguments' => ['access content'],
    'type' => MENU_NORMAL_ITEM,
    'file' => 'pages/dataset_doi/files.inc',
  ];

  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  $items['tpps/autocomplete/%'] = [
    'title' => 'TPPS Autocomplete',
    'description' => 'Autocomplete functions for TPPS module',
    'page callback' => 'tpps_autocomplete',
    'page arguments' => [2],
    'access callback' => 'tpps_access',
    'access arguments' => ['access content'],
