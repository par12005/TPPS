/**
 * Implements 'zenodo_deposit_new_version_created'.
 */
function tpps_zenodo_deposit_new_version_created(array $data) {
  $debug_mode = FALSE;
  if (empty($data['accession'])) {
    return;
  }
  $submission = new Submission($data['accession']);
  if ($submission->doesNotExist()) {
    // @todo Is it an error? Should error message be shown?
    return;
  }
  $deposit_id = $submission->getZenodoDepositId();
  $new_deposit_id = $data['response']['id'] ?? NULL;
  if (!empty($new_deposit_id) && $deposit_id != $new_deposit_id) {
    // Store Zenodo Concept Record Id (for new depositions only).
    $conceptrecid = $data['response']['conceptrecid'] ?? NULL;
    $submission->setZenodoConceptRecordId($conceptrecid, $save_on_change = FALSE);
    // Store Deposit Id.
    $submission->setZenodoDepositId($new_deposit_id, $save_on_change = TRUE);
    // Note: Deposit Id can't be the same when Concept Record Id changed and
    // Deposit Id will be updated more often so it's safe enough not to force
    // $submission->save() usage but save only when Deposit Id changed.

    if ($debug_mode ?? FALSE) {
      dpm(print_r($data, 1));
      $message = t('New Zenodo Deposit "#@new_deposit_id".'
        . '<br />Previous Zenodo Deposit Id: @deposit_id.',
        [
          '@new_deposit_id' => $new_deposit_id,
          '@deposit_id' => $deposit_id,
        ]
      );
      drupal_set_message($message);
    }
    drupal_set_message(t('New version of Zenodo Deposit was created.'));
  }
}

/**
 * Implements 'zenodo_deposit_discarded'.
 */
function tpps_zenodo_deposit_discarded(array $data) {
  $debug_mode = FALSE;
  if (empty($data['accession'])) {
    return;
  }
  $submission = new Submission($data['accession']);
  if ($submission->doesNotExist()) {
    // @todo Is it an error? Should error message be shown?
    return;
  }
  $conceptrecid = $submission->getZenodoConceptRecordId();
  $list = ZenodoDeposit::list(
    ['query' => ['q' => 'conceptrecid:' . $conceptrecid]]
  );

  if ($debug_mode ?? FALSE) {
    dpm(print_r($list, 1));
  }

  $discarded_deposit_id = $submission->getZenodoDepositId();
  // There will be only one active deposition in the list.
  $deposit_id = $list[0]['id'] ?? NULL;
  $submission->setZenodoConceptRecordId($conceptrecid, $save_on_change = FALSE);
  $submission->setZenodoDepositId($deposit_id, $save_on_change = TRUE);
  // Only published deposit could be rolled back.
  if ($discarded_deposit_id == $deposit_id) {
    // Undo changes made in edit mode.
    // Was: state == 'inprogress' && submitted == 1.
    // Became: state == 'done' && submitted == 1.
    drupal_set_message(t('Changes in Zenodo Deposition #@deposit_id was discarded.',
      ['@deposit_id' => $deposit_id]
    ));
  }
  else {
    // 'Discard' action must be used only when when editing already published
    // Deposition. 'Delete' must be used for unpublished Deposition.
    drupal_set_message(t('Zenodo Deposition #@discarded_deposit_id was discarded. '
      . 'Rolled back to Deposition #@deposit_id.',
      [
        '@discarded_deposit_id' => $discarded_deposit_id,
        '@deposit_id' => $deposit_id,
      ]
    ));
    SubmissionCache::updateSingle($submission);
  }
}

/**
 * Implements 'submission_dataset_doi_updated'.
 */
function tpps_submission_dataset_doi_updated(array $data) {
  // New.
  $dataset_doi = $data['new'];
  // Stored values of Dataset DOI.
  $state_dataset_doi = $data['old'];

  if (is_null($dataset_doi ?? NULL)) {
    drupal_set_message(t('Dataset DOI was unset.',
      ['@dataset_doi' => $dataset_doi]
    ));
  }
  else {
    drupal_set_message(t(
      'Dataset DOI was set to <strong>@dataset_doi</strong>.',
      ['@dataset_doi' => $dataset_doi]
    ));
  }
}

/**
 * Implements 'form_FORM_ID_alter' for 'tppsc_main' form.
 */
function tpps_form_tppsc_main_alter($form, $form_state) {

  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // Fix error "The file used in the ...  field may not be referenced."
  // When file is present in file system and submission has it's id but file
  // has no usage record this error will be shown.
  // Add usage to avoid validation issues.
  $submission = new Submission();
  $submission->setState($form_state);
  if (!$submission->isEmpty()) {
    $file_list = $submission->getFileIdList();
    if (!empty($file_list)) {
      foreach (array_keys($file_list) as $fid) {
        $file = TppsFile::load($fid);
        if ($file && TppsFile::isEmptyUsage($file, $submission->accession)) {
          TppsFile::addUsage($file, $submission->accession);
        }
      }
    }
  }

  // Process 'Remove' button for files.
  // Get parents.
  if (
    count($form_state['values'] ?? NULL) != 2
    || strpos($_GET['q'], 'file/ajax/') === FALSE
  ) {
    return;
  }
  // File was removed from page using 'Remove' button.
  $parents = TppsArray::getPath($form_state['values']);
  $fid = TppsArray::get($form, array_merge($parents, ['#default_value']));
  $file = TppsFile::load($fid);
  if (
    !(empty($fid)) && !empty($file)
    && empty(TppsArray::get($form_state['input'], array_merge($parents, ['fid'])))
  ) {
    $accession = $form_state['input']['accession'];
    TppsFile::deleteUsage($file, $accession);
  }
}

