  $items['api/file/%file/usage'] = [
    'title' => "Lists Usage to File",
    'page callback' => 'tpps_api_file_usage_list',
    // 2: Managed File Id.
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
    'file' => 'api/file/usage/list.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  $items['api/file/%file/usage/add/%'] = [
    'title' => "Adds Usage to File",
    'page callback' => 'tpps_api_file_usage_add',
    // 2: Managed File Id.
    // 5: study accession. E.g., 'TGDR1040'.
    'page arguments' => [2, 5],
    'access callback' => 'tpps_api_access',
    'file' => 'api/file/usage/add.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  $items['api/file/%file/usage/delete/%'] = [
    'title' => "Adds Usage to File",
    'page callback' => 'tpps_api_file_usage_delete',
    // 2: Managed File Id.
    // 5: study accession. E.g., 'TGDR1040'.
    'page arguments' => [2, 5],
    'access callback' => 'tpps_api_access',
    'file' => 'api/file/usage/delete.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  $items['api/submission/%tpps_submission/vcf'] = [
    'title' => 'List of VCF Files Ids',
    'page callback' => 'tpps_api_submission_vcf_files_list',
    // 3: Submission Accession (TGDRxxxx)
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
    'file' => 'api/submission/vcf.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  $items['api/submission/%tpps_submission/view'] = [
    'title' => 'TPPS Submission Data',
    'description' => 'TPPS Submission Data in JSON format',
    'page callback' => 'tpps_api_submission_view',
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
    'file' => 'api/submission/view.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  $items['api/submission/%tpps_submission/zenodo/deposit'] = [
    'title' => 'Zenodo Deposition',
    'description' => 'Zenodo Deposition in JSON format',
    'page callback' => 'tpps_api_submission_zenodo_deposit',
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
    'file' => 'api/submission/zenodo_deposit.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  $items['api/submission/%tpps_submission/zenodo/files'] = [
    'title' => 'Zenodo Deposition Files',
    'description' => 'Zenodo Deposition Files in JSON format',
    'page callback' => 'tpps_api_submission_zenodo_files',
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
    'file' => 'api/submission/zenodo_files.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  $items['api/submission/%/cache'] = [
    'title' => 'TPPS Submission Cache',
    'description' => 'TPPS Submission Cache Item in JSON format',
    'page callback' => 'tpps_api_submission_cache',
    'page arguments' => [2],
    'access callback' => 'tpps_api_access',
    'file' => 'api/submission/cache.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];

  $items['api/submission/%/tag/%/%'] = [
    'title' => 'Link Submission and Tag',
    'description' => 'Links Submission and Submission Tag',
    'page callback' => 'tpps_api_submission_tag_action',
    // 2: Study accession,
    // 4: Tag Id,
    // 5: Action ('link', 'unlink').
    'page arguments' => [2, 4, 5],
    'access callback' => 'tpps_api_access',
      'access arguments' => ['administer tpps module'],
    'file' => 'api/submission/tag.inc',
    'type' => MENU_CALLBACK,
    'delivery callback' => 'drupal_json_output',
  ];
  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // Menu items from function tpps_api_paths().

  // All API paths start with `tpps/api/` and return their data as JSON objects.
  // The api paths include:
  //   check_accession/<accession number>
  //   submission/<accession number>
  //   submissions?<arguments>
  //   submission_info?<arguments>

  // tpps/api/refresh_views calls tpps_api_refresh_views which will
  // update the tpps specific views used in particular for details pages
  $items['tpps/api/refresh_views'] = [
    'title' => 'TPPS Refresh Views',
    'page callback' => 'tpps_api_refresh_views',
    'page arguments' => [],
    'access arguments' => ['access content'],
    'delivery callback' => 'drupal_json_output',
    'type' => MENU_CALLBACK,
  ];

  // tpps/api/check_accession calls tpps_api_check_accession on a provided
  // accession number. It will return TRUE for accessions with a valid
  // TPPS submission and FALSE for all other accessions.
  $items['tpps/api/check_accession/%'] = [
    'title' => 'TPPS Check Accession',
    'page callback' => 'tpps_api_check_accession',
    'page arguments' => [3],
    'access callback' => 'tpps_access',
    'access arguments' => ['access content'],
    'delivery callback' => 'drupal_json_output',
    'type' => MENU_CALLBACK,
  ];

  // tpps/api/submission calls tpps_load_submission on a provided accession.
  // If a valid TPPS submission exists for the accession, it will return the
  // form_state of the submission.
  $items['tpps/api/submission/%'] = [
    'title' => 'TPPS Raw Submissions',
    'page callback' => 'tpps_api_get_submission_state',
    'page arguments' => [3],
    'access callback' => 'tpps_access',
    'access arguments' => ['access content'],
    'delivery callback' => 'drupal_json_output',
    'type' => MENU_CALLBACK,
  ];

  // tpps/api/submissions calls tpps_api_submission_query. If no query
  // conditions are provided, it will return information about all of the
  // existing valid TPPS submissions. Otherwise, it will filter the submissions
  // based on the provided conditions. Please see the tpps_api_submission_query
  // function for more details.
  $items['tpps/api/submissions'] = [
    'title' => 'TPPS Submissions Query',
    'page callback' => 'tpps_api_submission_query',
    'page arguments' => [],
    'access callback' => 'tpps_access',
    'access arguments' => ['access content'],
    'delivery callback' => 'drupal_json_output',
    'type' => MENU_CALLBACK,
  ];

  // tpps/api/submission_info calls tpps_api_submission_info. It will return
  // data on multiple TPPS submissions based on accessions provided in the
  // API query. The data returned can be specified using the data query
  // argument. Please see the tpps_api_submission_info function for more
  // details.
  $items['tpps/api/submission_info'] = [
    'title' => 'TPPS Submission Data',
    'page callback' => 'tpps_api_submission_info',
    'page arguments' => [],
    'access callback' => 'tpps_access',
    'access arguments' => ['access content'],
    'delivery callback' => 'drupal_json_output',
    'type' => MENU_CALLBACK,
  ];

  $items['tpps/api/files/%'] = [
    'title' => 'TPPS Submission Files Download',
    'page callback' => 'tpps_api_compress_files',
    'page arguments' => [3],
    'access callback' => 'tpps_access',
    'access arguments' => ['access tpps details'],
    'type' => MENU_NORMAL_ITEM,
  ];
}

/**
 * TPPS API access callback.
 *
 * Checks token in GET-parameter 'token' to allow access to API Endpoints.
 * Settings page to set/update token: /admin/config/tpps/api .
 */
function tpps_api_access() {
  global $user;
  $token = trim(variable_get('tpps_api_token'));
  if (
    empty($token)
    && (($_GET['token'] ?? NULL) != $token)
    && (!user_access('administer tpps module', $user))
  ) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Dynamyc menu item titles for TPPS Submisssion pages.
 *
 * @param string $accession
 *   Study Accession.
 * @param string $op
 *   Operation.
 * @param string $extra
 *   Extra data.
 *
 * @return string
 *   Returns menu item title.
 */
function tpps_submission_title($accession = '', $op = '', $extra = '') {
  return t('Submission @accession @op @extra',
    [
      '@op' => ucfirst($op ?? NULL),
      '@accession' => $accession ?? NULL,
      '@extra' => ($extra ? 'with ' . $extra : ''),
    ]
  );
}

