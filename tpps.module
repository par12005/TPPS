/**
 * Implements hook_block_view_alter().
 *
 * https://api.drupal.org/api/drupal/modules%21block%21block.api.php/function/hook_block_view_alter/7.x
 *
 * Note that instead of hook_block_view_alter(), which is called for all blocks,
 * you can also use hook_block_view_MODULE_DELTA_alter() to alter a specific block.
 */
function tpps_block_view_alter(&$data, $block) {
  switch ($block->delta) {
    case 'tpps_status':
      // Note: Block exists and appears on the /tpps/submission/TGDR1136/remove
      // page in the right sidebar.
      $data['content'] = theme('submission_block', ['data' => $data]);
      break;

    default:
      break;
  }
}

/**
 * Implements hook_media_browser_plugins_alter().
 */
function tpps_media_browser_plugins_alter(&$plugins) {
  unset($plugins['upload']);
  unset($plugins['media_default--media_browser_my_files']);
}

// WARNING: Required because dev-server has PHP 7.0.2.
//
// There are several ways to provide this functionality for versions
// prior to PHP 7.3.0. It is possible to use array_keys(),
// but that may be rather inefficient.
// It is also possible to use reset() and key(),
// but that may change the internal array pointer.
// An efficient solution, which does not change the internal
// array pointer, written as polyfill.
if (!function_exists('array_key_first')) {

  /**
   * Polifill for array_key_first() implemented in PHP 7.3.0 and higher.
   *
   * @param array $arr
   *   Array to be processed.
   *
   * @return string
   *   Returns key of the first element of the given array.
   */
  function array_key_first(array $arr) {
    foreach ($arr as $key => $unused) {
      return $key;
    }
    return NULL;
  }

}

// WARNING: Required because dev-server has PHP 7.0.2.
//
// See https://www.php.net/manual/en/function.array-key-last.php#124007
if (!function_exists('array_key_first')) {

  /**
   * Polifill for array_key_last() implemented in PHP 7.3.0 and higher.
   *
   * @param array $arr
   *   Array to be processed.
   *
   * @return string
   *   Returns key of the last element of the given array.
   */
  function array_key_first(array $arr) {
    foreach ($arr as $key => $unused) {
      return $key;
    }
  }

}

/**
 * Implements hook_init().
 */
function tpps_init() {
  global $_SESSION;
  global $tpps;

  // Removed spam message:
  // Notice: Undefined variable: show_nafgs_menu in include() (line 147 of
  // /var/www/Drupal/sites/all/themes/sites/all/themes/dawn/tpl/page.tpl.php).
  // It can't be fixed because there is no write access to this module.
  if (!empty($_SESSION['messages']['error'])) {
    $spam = 'Undefined variable: show_nafgs_menu in';
    foreach ($_SESSION['messages']['error'] as $index => $item) {
      if (strpos($item, $spam)) {
        unset($_SESSION['messages']['error'][$index]);
      }
    }
    if (empty($_SESSION['messages']['error'])) {
      unset($_SESSION['messages']['error']);
    }
  }
  if ($_GET['q'] == 'admin/reports/dblog' && $tpps->watchdog_cleanup) {
    tpps_watchdog_cleanup();
  }
}

/**
 * Gets list of hardcoded rules to cleanup watchdog messages.
 *
 * WARNING:
 * 'message' is string (not array)
 * 'variables' could be string and array.
 */
function tpps_watchdog_cleanup_rules() {
  return [
    [
      'uid' => '0',
      'type' => 'php',
      'message' => '%type: !message in %function (line %line of %file).',
      'variables' => [
        'tripal_galaxy_form_webform_client_form_alter()',
        '/var/www/Drupal/sites/all/modules/tripal_galaxy/tripal_galaxy.module',
        '614',
      ],
      'severity' => WATCHDOG_NOTICE,
    ],
    [
      'example' => "Warning: Invalid argument supplied for foreach() in file_entity_set_title_alt_properties_on_file_fields() (line 248 of /var/www/Drupal/sites/all/modules/file_entity/file_entity.file.inc).",
      'uid' => '0',
      'type' => 'php',
      'message' => '%type: !message in %function (line %line of %file).',
      'variables' => [
        'Invalid argument supplied for foreach()',
        '248',
        '/var/www/Drupal/sites/all/modules/file_entity/file_entity.file.inc',
      ],
      'severity' => WATCHDOG_WARNING,
    ],
    [
      'example' => "Cron thread 1 started.",
      'uid' => '0',
      'type' => 'serial_launcher',
      'message' => 'Cron thread %thread started',
      'variables' => 'a:1:{s:7:"%thread";i:1;}',
      'severity' => '7',
    ],
    [
      'example' => 'Did not delete temporary file "public://tpps_accession/test_accession_122.csv" during garbage collection, because it is in use by the following modules: tpps.',
      'uid' => '0',
      'type' => 'file system',
      'message' => 'Did not delete temporary file "%path" during garbage '
      . 'collection, because it is in use by the following modules: %modules.',
      'severity' => '6',
    ],
    [
      'example' => "bio_data/132727.",
      'uid' => '0',
      'type' => 'access denied',
      'message' => 'bio_data/',
      'severity' => WATCHDOG_WARNING,
    ],
    [
      'example' => "Notice: Undefined variable: show_nafgs_menu in include() (line 147 of /var/www/Drupal/sites/all/themes/sites/all/themes/dawn/tpl/page.tpl.php).",
      'type' => 'php',
      'variables' => [
        'Undefined variable: show_nafgs_menu',
        '/var/www/Drupal/sites/all/themes/sites/all/themes/dawn/tpl/page.tpl.php',
        '147',
      ],
      'message' => '%type: !message in %function (line %line of %file).',
      'severity' => WATCHDOG_NOTICE,
    ],
    [
      'example' => "Warning: Invalid argument supplied for foreach() in file_entity_set_title_alt_properties_on_file_fields() (line 248 of /var/www/Drupal/sites/all/modules/file_entity/file_entity.file.inc).",
      'type' => 'php',
      'variables' => [
        'Invalid argument supplied for foreach()',
        '248',
        '/var/www/Drupal/sites/all/modules/file_entity/file_entity.file.inc',
      ],
      'severity' => WATCHDOG_WARNING,
    ],
    [
      'example' => "Cleaned up 128 released locks.",
      'uid' => '0',
      'type' => 'ultimate_cron_lock',
      'message' => 'Cleaned up @count released locks',
      'severity' => WATCHDOG_DEBUG,
    ],
    [
      'example' => "Access denied: node/add.",
      'uid' => '0',
      'type' => 'access denied',
      'message' => 'node/add',
      'severity' => WATCHDOG_WARNING,
    ],
  ];
}

/**
 * Dumps single watchdog message.
 *
 * @param int $wid
 *   Watchdog message Id.
 */
function tpps_watchdog_dump($wid) {
  $result = db_query("SELECT * FROM public.watchdog where wid= " . $wid)->fetchAssoc();
  dpm(var_export($result, 1));
}

/**
 * Removes spam-messages in watchdog log.
 */
function tpps_watchdog_cleanup() {
  $rule_list = tpps_watchdog_cleanup_rules();
  $table = 'watchdog';
  if ($custom_rules = variable_get('tpps_watchdog_cleanup_filter', [])) {
    if (is_array($custom_rules) && !empty($custom_rules)) {
      $rule_list = array_merge($rule_list, $custom_rules);
    }
  }
  // @todo Minor. Remove duplidates and leave only one (modified) message
  // with number of the removed items.
  foreach ($rule_list as $filter_item) {
    if (!is_array($filter_item)) {
      watchdog('tpps', 'Watchdog cleanup rules are broken.', [], WATCHDOG_ERROR);
      continue;
    }
    if (
      !empty($filter_item['variables'])
      && is_array($filter_item['variables'])
    ) {
      $query = db_select($table, 't')->fields('t', []);
      foreach ($filter_item as $field => $value) {
        switch ($field) {
          case 'example':
            continue;

          case 'variables':
            foreach ($value as $string_value) {
              $query->where(
                "position('" . $string_value . "'::bytea in " . $field . ") > 0"
              );
            }
            break;

          default:
            $query->condition($field, $value);
            break;
        }
      }
      $list = $query->execute()->fetchCol('wid');
      if (!empty($list)) {
        db_delete('watchdog')->condition('wid', $list, 'IN')->execute();
      }
    }
    else {
      $query = db_delete($table);
      foreach ($filter_item as $field => $value) {
        if ($field == 'example') {
          continue;
        }
        if (strpos($value, '%') !== FALSE) {
          $query->condition($field, $value);
        }
        else {
          $query->condition($field, '%' . db_like($value) . '%', 'LIKE');
        }
      }
      $query->execute();
    }
  }
}

