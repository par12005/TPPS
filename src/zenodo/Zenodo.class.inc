<?php

/**
 * @file
 * Contains 'Zenodo' class.
 *
 * Depends from 'RestAPI' class.
 *
 * Example of the DOI generated by Zenodo: 10.5281/zenodo.14918129.
 *
 * Introduction
 * The Zenodo REST API currently supports:
 *    Deposit — upload and publishing of research outputs (identical to
 *      functionality available in the user interface).
 *    Records — search published records.
 *    Files — download/upload of files.
 *
 * The following REST APIs are currently in testing before we launch them
 * in beta with full documentation:
 *
 *    Communities - search communities.
 *    Funders — search for funders.
 *    Grants — search for grants.
 *    Licenses — search for licenses.
 *
 * You can have a sneak peek at the APIs in test from our root endpoint:
 * https://zenodo.org/api/
 *
 * Classes which extends this class:
 * - ZenodoDeposit (publish, newversion, edit and etc.)
 * - ZenodoFile (default actions with files).
 *
 * ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
 * Dependencies:
 *
 * - 'RestAPI' class.
 * - Drupal variables:
 *   'tpps_zenodo_debug_mode',
 *   'tpps_zenodo_access_token_live',
 *   'tpps_zenodo_access_token_sandbox',
 *   'tpps_zenodo_host_greedy_search',
 * - Drupal hooks system. See /tpps.api.inc file.
 */

// ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
// @todo Minor. Implement ability to send access token in the headers so it
// will never appears in any server's logs.

/**
 * Zenodo API common actions (like CRUD).
 *
 * Actions are: upldate, create, deleted, list, retrieve.
 *
 * @package tpps
 * @author Vlad Savitsky <vlad.savitsky@gmail.com>
 */
class Zenodo {

  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // API scope: deposit:write.

  /**
   * Lists all depositions/deposition files/records.
   *
   * Deposition: Lists all depositions for the currently authenticated user.
   * Files: List all deposition files for a given deposition.
   * Records: List all open access records.
   *
   * Scope (permissions): deposit:write.
   *
   * @param array $data
   *   Data for request. Required keys are: 'query'.
   *   Filter query. See https://developers.zenodo.org/?python#list.
   * @param bool $reset
   *   When TRUE statically cached data will be updated.
   *
   * @return array
   *   Returns array of deposition resources.
   *   See https://developers.zenodo.org/?python#representation
   */
  public static function list(array $data, $reset = FALSE) {
    $key = $data ? $data['deposit_id'] . ($data['file_id'] ?? '') : 'list';
    $static_cache = &drupal_static(__METHOD__);
    if ($reset || !isset($static_cache[$key])) {
      $data['query'] = $data['query'] ?? [];
      if (function_exists('drupal_alter')) {
        // Call all implementations of hooks:
        // - hook_zenodo_deposit_list_alter(),
        // - hook_zenodo_file_list_alter().
        drupal_alter(static::getHookName(__FUNCTION__), $data);
      }
      $data['url'] = static::buildUrl($data);
      $data['response'] = RestAPI::get($data['url'], $data['query']);
      $static_cache[$key] = $data['response'] ?? '';
    }
    return $static_cache[$key];
  }

  /**
   * Retrieves a single deposition resource.
   *
   * Scope (permissions): deposit:write.
   *
   * Used greedy search of the Zenodo Host to find Deposition.
   *
   * @param array $data
   *   Data for request. Required keys are: 'deposit_id'.
   * @param bool $reset
   *   When TRUE statically cached data will be updated.
   *
   * @return array
   *   Returns array of deposition resources.
   *   See https://developers.zenodo.org/?python#representation
   */
  public static function retrieve(array $data, $reset = FALSE) {
    static::validateRequired(['deposit_id'], $data);

    $key = $data['deposit_id'] . ($data['file_id'] ?? '');
    $static_cache = &drupal_static(__METHOD__);
    if ($reset || !isset($static_cache[$key])) {
      if (function_exists('drupal_alter')) {
        // Call all implementations of hooks:
        // - hook_zenodo_deposit_retrieve_alter(),
        // - hook_zenodo_file_retrieve_alter().
        // Note: Hooks must be called only once.
        drupal_alter(static::getHookName(__FUNCTION__), $data);
      }
      $data['url'] = static::buildUrl($data);
      try {
        $data['response'] = RestAPI::get($data['url'], $data);
      }
      catch (Exception $e) {
        if ($e->getCode() == 404) {
          $message = t(
            "Zenodo Deposition #@deposit_id wasn't found on @host Zenodo host.",
            [
              '@deposit_id' => $data['deposit_id'],
              '@host' => (ZenodoHost::isLive() ? 'Live' : 'Sandbox'),
            ]
          );
        }
        elseif ($e->getCode() == 403) {
          $message = t(
            "Access to Zenodo Deposition #@deposit_id denied on @host Zenodo host.",
            [
              '@deposit_id' => $data['deposit_id'],
              '@host' => (ZenodoHost::isLive() ? 'Live' : 'Sandbox'),
            ]
          );
        }
        else {
          $message = $e->getMessage();
        }
        throw new Exception($message, $e->getCode());
      }

      // Note: Hooks must be called only once.
      if (function_exists('module_invoke_all')) {
        module_invoke_all(static::getHookName('retrieved'), $data);
      }
      $static_cache[$key] = $data['response'];
    }
    return $static_cache[$key];
  }

  /**
   * Deletes deposition/files resource.
   *
   * Scope (permissions): deposit:write.
   * See https://developers.zenodo.org/?python#delete.
   *
   * Note:
   * 1. Since operation used for both (Deposits and Files) we use Drupal hooks.
   * 2. Only unpublished depositions may be deleted.
   *
   * @param array $data
   *   Data for request.
   *   Required keys:
   *     Zenodo Deposit: 'deposit_id'.
   *     Zenodo File: 'deposit_id', 'file_id'.
   *
   * @return mixed
   *   Returns API response.
   *
   * @todo Add response validation:
   * Success Response:
   *   Code: 201 Created
   *   Body: Empty.
   * Error Response:
   *   404 Not found: Deposition does not exist.
   *   403 Forbidden: Deleting an already published deposition.
   */
  public static function delete(array $data) {
    if (function_exists('drupal_alter')) {
      // Call all implementations of hooks:
      // - hook_zenodo_deposit_delete_alter(),
      // - hook_zenodo_file_delete_alter().
      drupal_alter(static::getHookName(__FUNCTION__), $data);
    }
    static::validateRequired(['deposit_id'], $data);

    // Check if Deposition could be removed.
    $deposition = ZenodoDeposit::retrieve($data);
    if (!empty($deposition['submitted'])) {
      if (static::getClassName() == 'ZenodoDeposit') {
        $message = t("Deposition was published and can't be removed anymore.");
      }
      elseif (static::getClassName() == 'ZenodoFile') {
        $message = t("Can't remove files of already published Zenodo Deposition.");
      }
      throw new Exception($message);
    }

    $data['url'] = static::buildUrl($data);
    $data['response'] = RestAPI::delete($data['url']);

    // Note: When Deposit not found we stil need to remove it's id from Submission.
    if (function_exists('module_invoke_all')) {
      module_invoke_all(static::getHookName('deleted'), $data);
    }
  }

  /**
   * Creates a blank Zenodo DOI Deposit/Files.
   *
   * Scope (permissions): deposit:write.
   *
   * @param array $data
   *   Data for request.
   *   When $data['accession'] is not set then empty Zenodo Deposition will
   *   be created. When it's not empty and has TPPS Submission accession
   *   (e.g., 'TGDRxxxx) then $data will be populated with study's data.
   *
   * @return array
   *   Returns Zenodo Deposition data or empty array.
   */
  public static function create(array $data = []) {
    $data['payload'] = $data['payload'] ?? [];
    $data['header'] = $data['header'] ?? [];

    if (function_exists('module_invoke_all')) {
      // Note: Zenodo Deposit Id will be stored in Submission in Drupal-hook:
      // 'tpps_zenodo_deposit_before_create().
      module_invoke_all(static::getHookName('before_create'), $data);
    }

    if (static::getClassName() == 'ZenodoDeposit') {
      // When (by mistake) study has Deposit Id but it wasn't found on any
      // Zenodo Host we allow to create new Deposition to overwrite existing
      // Deposit Id value without hacking Submission's record in DB so we must
      // remove 'deposit_id' to have correct API Endpoint URL.
      unset($data['deposit_id']);
    }
    elseif (static::getClassName() == 'ZenodoFile') {
      // Note: ZenodoDeposit class uses 'action' to pass extra actions like
      // 'edit', 'newversion', 'discard' and etc.
      $data['use_bucket_api'] = TRUE;
    }
    if (function_exists('drupal_alter')) {
      // Call all implementations of hooks:
      // - hook_zenodo_deposit_create_alter(),
      // - hook_zenodo_file_create_alter().
      drupal_alter(static::getHookName(__FUNCTION__), $data);
    }

    $data['url'] = static::buildUrl($data);
    if (static::getClassName() == 'ZenodoDeposit') {
      $data['response'] = RestAPI::post($data['url'], $data['payload'], $data['header']);
    }
    elseif (static::getClassName() == 'ZenodoFile') {
      // We use New Bucket API which require PUT instead of POST method.
      $data['response'] = RestAPI::put($data['url'], $data['payload'], $data['header']);
    }

    if (function_exists('module_invoke_all')) {
      // Note: Zenodo Deposit Id will be stored in Submission in Drupal-hook:
      // 'tpps_zenodo_deposit_created().
      module_invoke_all(static::getHookName('created'), $data);
    }
    return $data['response'];
  }

  /**
   * Updates an existing deposition/deposition file resource.
   *
   * Deposition file:
   * Currently the only use is renaming an already uploaded file.
   * If you one to replace the actual file, please delete the file
   * and upload a new file.
   *
   * Scope (permissions): deposit:write.
   *
   * @param array $data
   *   Data for request. Required keys are: 'deposit_id', 'metadata'.
   *
   * @return array
   *   Returns Zenodo Deposition data or empty array.
   */
  public static function update(array $data) {
    $data['payload'] = $data['payload'] ?? [];
    static::validateRequired(['deposit_id'], $data);
    if (function_exists('drupal_alter')) {
      // Call all implementations of hooks:
      // - hook_zenodo_deposit_update_alter(),
      // - hook_zenodo_file_update_alter().
      drupal_alter(static::getHookName(__FUNCTION__), $data);
    }
    if (static::getClassName() != 'ZenodoDeposit') {
      $message = t('Not implemented for @class.',
        ['@class' => static::getClassName()]
      );
      throw new Exception($message);
    }
    static::validateRequired(['metadata'], $data['payload']);
    $data['url'] = static::buildUrl($data);
    $data['response'] = RestAPI::put($data['url'], $data['payload']);

    if (function_exists('module_invoke_all')) {
      module_invoke_all(static::getHookName('updated'), $data);
    }
    return $data['response'];
  }

  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // Custom methods.

  /**
   * Builds Endpoint URL for Zenodo API based on class and action.
   *
   * WARNING: Uses statically set Zenodo Host.
   * Use ZenodoHost::search() to find host where Zenodo Deposition was created.
   * See: ZenodoHost::toggle() and ZenodoHost::set() methods.
   *
   * @param array $data
   *   Data for requiest.
   *   URL will be build using necessary items from $data based on class name.
   *   Part of the URL after 'https://zenodo.org/api/deposit/depositions'.
   *
   * @return mixed
   *   Returns FALSE in case of errors.
   *   Returns generated absolute path to Zenodo API Endpoint.
   */
  public static function buildUrl(array $data) {
    $protocol = 'https://';
    $host = ZenodoHost::get();
    $path = $protocol . $host;
    // Add base path and endpoint.
    switch (static::getClassName()) {
      case 'ZenodoDeposit':
        // $data['deposit_id'] is empty for 'list' API action.
        // Example: /api/deposit/depositions/:id.
        $path .= static::BASE_PATH
          . (empty($data['deposit_id']) ? '' : '/' . $data['deposit_id']);
        $action = $data['action'] ?? NULL;
        if ($action) {
          if (in_array($action, ZenodoDeposit::getActionList())) {
            $path .= '/actions/' . $action;
          }
          else {
            // @TODO Add hook and move exception there.
            $message = t(
              '@class::@caller_method() uses unsupported Zenodo Deposition '
              . 'action: @name. Allowed actions: @list.',
              [
                '@name' => $action,
                '@list' => implode(', ', ZenodoDeposit::getActionList()),
                '@class' => static::getClassName(),
                '@caller_method' => debug_backtrace(
                  !DEBUG_BACKTRACE_PROVIDE_OBJECT | DEBUG_BACKTRACE_IGNORE_ARGS, 2
                )[1]['function'],
              ]
            );
            throw new Exception($message);
          }
        }
        break;

      case 'ZenodoFile':
        if (empty($data['use_bucket_api'])) {
          // Zenodo Files API.
          // Example: /api/deposit/depositions/:id/files/:file_id.
          $path .= static::BASE_PATH
            . (empty($data['deposit_id']) ? '' : '/' . $data['deposit_id'])
            . '/files'
            . (empty($data['file_id']) ? '' : '/' . $data['file_id']);
        }
        else {
          // New Zenodo Bucket API.
          // See https://developers.zenodo.org/?shell#quickstart-upload
          static::validateRequired(['deposit_id'], $data);
          $deposition = ZenodoDeposit::retrieve($data);
          $path = $deposition['links']['bucket'];
          if (!empty($data['drupal_file']->filename)) {
            $path .= '/' . $data['drupal_file']->filename;
          }
        }
        break;

      case 'ZenodoRecords':
        // Example: /api/records/:id.
        $path .= static::BASE_PATH
          . (empty($data['deposit_id']) ? '' : '/' . $data['deposit_id']);
        break;
    }
    if (empty($path)) {
      return FALSE;
    }
    // Build absolute URL with access token.
    return static::addAccessToken($path);
  }

  /**
   * Checks if all required items to make API requiest was set.
   *
   * Throw an exception when some items are missing.
   *
   * @param array $required_items
   *   List of required keys in the $data.
   * @param array $data
   *   Data prepared for API requiest.
   */
  public static function validateRequired(array $required_items, array $data) {
    $missing_items = [];
    foreach ($required_items as $name) {
      if (!isset($data[$name])) {
        $missing_items[] = $name;
      }
    }
    if (!empty($missing_items)) {

// @TODO Add hook and move exception there.

      // Since it's required items we throw an exception.
      $message = t(
        '@class::@caller_method() is missing data: @list.',
        [
          '@list' => implode(', ', $missing_items),
          '@class' => static::getClassName(),
          '@caller_method' => debug_backtrace(
            !DEBUG_BACKTRACE_PROVIDE_OBJECT | DEBUG_BACKTRACE_IGNORE_ARGS, 2
          )[1]['function'],
        ]
      );
      throw new Exception($message);
    }
  }

  /**
   * Gets Class Name.
   *
   * Since 5.5 you can use class keyword for the class name resolution,
   * which would be a lot faster than making function calls.
   * Also works with interfaces.
   *
   * C extends B extends A
   *
   * static::class  // MyNamespace\ClassC when run in A
   * self::class    // MyNamespace\ClassA when run in A
   * parent::class  // MyNamespace\ClassB when run in C
   * MyClass::class // MyNamespace\MyClass
   *
   * See https://stackoverflow.com/questions/506705
   *
   * @return string
   *   Returns class name when called from static method.
   */
  public static function getClassName() {
    return static::class;
  }

  /**
   * Generate Drupal hook name based on class name.
   *
   * @param string $action
   *   Method name.
   *
   * @return string
   *   Returns name of the hook (without module name prefix).
   */
  public static function getHookName($action) {
    switch (static::getClassName()) {
      case 'ZenodoFile':
        $prefix = 'zenodo_file_';
        break;

      case 'ZenodoRecords':
        $prefix = 'zenodo_record_';
        break;

      case 'ZenodoDeposit':
      default:
        $prefix = 'zenodo_deposit_';
        break;
    }
    return $prefix . $action;
  }


  /**
   * Adds Access Token to given URL.
   *
   * @param string $url
   *   URL.
   *
   * @return string
   *   Returns URL which includes Access Token as a GET-parameter.
   */
  public static function addAccessToken($url) {
    $host = ZenodoHost::get();
    // Access Token.
    if ($host == ZenodoHost::LIVE_HOST) {
      $access_token = variable_get('tpps_zenodo_access_token_live');
    }
    else {
      $access_token = variable_get('tpps_zenodo_access_token_sandbox');
    }
    return url($url, [
      'query' => ['access_token' => $access_token],
      //'external' => $external,
    ]);
  }

}
