<?php

/**
 * @file
 * Contains 'Zenodo' class.
 *
 * Example of the DOI generated by Zenodo: 10.5281/zenodo.14918129.
 *
 * Introduction
 * The Zenodo REST API currently supports:
 *    Deposit — upload and publishing of research outputs (identical to
 *      functionality available in the user interface).
 *    Records — search published records.
 *    Files — download/upload of files.
 *
 * The following REST APIs are currently in testing before we launch them
 * in beta with full documentation:
 *
 *    Communities - search communities.
 *    Funders — search for funders.
 *    Grants — search for grants.
 *    Licenses — search for licenses.
 *
 * You can have a sneak peek at the APIs in test from our root endpoint:
 * https://zenodo.org/api/
 *
 * @todo Minor. Implement alter-hooks for ZenodoDeposit Actions.
 */

/**
 * Manages requests to Zenodo API.
 *
 * @package tpps
 * @author Vlad Savitsky <vlad.savitsky@gmail.com>
 */
class ZenodoDeposit extends Zenodo {

  // Prefix of the API URL.
  const BASE_PATH = '/api/deposit/depositions';

  // Zenodo Depositon States.
  // Seems it's for not yet submitted depositions ('submitted' == FALSE).
  // See https://developers.zenodo.org/#representation
  const STATE_INPRPOGRESS = 'inprogress';
  const STATE_DONE = 'done';
  const STATE_ERROR = 'error';
  // State 'unsubmitted' wan't listed in docs but new depositions has it.
  const STATE_UNSUBMITTED = 'unsubmitted';

  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // API scope: deposit:actions.

  /**
   * Publish a deposition.
   *
   * Scope (permissions): deposit:actions.
   * Note, once a deposition is published, you can no longer delete it.
   * See: https://developers.zenodo.org/?shell#publish.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *
   * @return mixed
   *   Returns API response.
   */
  public static function publish(array $data) {
    $data['payload'] = $data['payload'] ?? [];
    $data['action'] = 'publish';

    // Call all implementations of hooks:
    // - hook_zenodo_deposit_publish_alter(),
    drupal_alter(static::getHookName(__FUNCTION__), $data);

    $data['url'] = static::buildActionUrl($data);
    $data['response'] = RestAPI::post($data['url'], $data['payload']);
    $data['response'] = $data['response'] ? RestAPI::decodeJSON($data['response']) : [];

    module_invoke_all(static::getHookName('published'), $data);
    return $data['response'];
  }

  /**
   * Unlock already submitted deposition for editing.
   *
   * Scope (permissions): deposit:actions.
   * See: https://developers.zenodo.org/?shell#edit.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *
   * @return mixed
   *   Returns API response.
   */
  public static function edit(array $data) {
    $data['action'] = 'edit';

    // Call all implementations of hooks:
    // - hook_zenodo_deposit_edit_alter(),
    drupal_alter(static::getHookName(__FUNCTION__), $data);

    $data['url'] = static::buildActionUrl($data);
    $data['response'] = RestAPI::post($data['url']);
    $data['response'] = $data['response'] ? RestAPI::decodeJSON($data['response']) : [];

    module_invoke_all(static::getHookName('edited'), $data, $response);
    return $data['response'];
  }

  /**
   * Discard changes in the current editing session.
   *
   * Scope (permissions): deposit:actions.
   * See: https://developers.zenodo.org/?shell#discard.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *
   * @return mixed
   *   Returns API response.
   */
  public static function discard(array $data) {
    $data['action'] = 'discard';
    $data['payload'] = $data['payload'] ?? [];
    // Call all implementations of hooks:
    // - hook_zenodo_deposit_discard_alter(),
    drupal_alter(static::getHookName(__FUNCTION__), $data);

    $data['url'] = static::buildActionUrl($data);
    $data['response'] = RestAPI::post($data['url'], $data['payload']);
    $data['response'] = $data['response'] ? RestAPI::decodeJSON($data['response']) : [];

    module_invoke_all(static::getHookName('discarded'), $data);
    return $data['response'];
  }

  /**
   * Create a new version of a deposition.
   *
   * Scope (permissions): deposit:actions.
   *
   * See: https://developers.zenodo.org/?shell#new-version.
   *
   * This action will create a new deposit, which will be a snapshot of the
   * current resouce, inheriting the metadata as well as snapshot of files.
   * The new version deposit will have a state similar to a new, unpublished
   * deposit, most importantly its files will be modifiable as for a new deposit.
   *
   * Only one unpublished new version deposit can be available at any moment,
   * i.e.: calling new version action multiple times will have no effect,
   * as long as the resulting new version deposit from the first call is not
   * published or deleted.
   *
   * NOTES:
   * - The response body of this action is NOT the new version deposit,
   *   but the original resource. The new version deposition can be accessed
   *   through the "latest_draft" under "links" in the response body.
   * - The id used to create this new version has to be the id of the latest
   *   version. It is not possible to use the global id that references all
   *   the versions.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *
   * @return mixed
   *   Returns API response.
   */
  public static function newVersion(array $data) {
    $data['action'] = 'newversion';

    // Call all implementations of hooks:
    // - hook_zenodo_deposit_new_version_alter(),
    drupal_alter(static::getHookName('new_version'), $data);

    $data['url'] = static::buildActionUrl($data);
    $data['response'] = RestAPI::post($data['url']);
    $data['response'] = $data['response'] ? RestAPI::decodeJSON($data['response']) : [];

    module_invoke_all(static::getHookName('new_version_created'), $data);
    return $data['response'];
  }

  /**
   * Builds API Endpoint for Action-commands.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *   'action' - string. Name of the action.
   *
   * @return string
   *   Returns absolute URL for Zenodo API Endpoint.
   */
  public static function buildActionUrl(array $data) {
    self::validateRequired(['deposit_id'], $data);
    return static::buildUrl($data) . '/actions/' . $data['action'];
  }

  /**
   * Checks if Zenodo Sandbox is in use.
   *
   * @return bool
   *   Returns TRUE when Zenodo Sandbox server is currenlty in use.
   */
  public static function isSandboxServer() {
    return (bool) variable_get('tpps_zenodo_debug_mode');
  }

  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // Different representations of the Zenodo Deposition Entity.

  /**
   * Prints single Deposition as a HTML-list.
   *
   * @param array $deposition
   *   Zenodo Deposition Enitiy.
   * @param string $format
   *   Output format. Possible values are: 'table' and 'list' (default).
   *
   * @return string
   *   Returns rendered HTML representation of the Deposition Entity.
   */
  public static function printDeposition(array $deposition, $format = 'list') {
    $output = '';
    if (!ZenodoDeposit::isDeposition($deposition)) {
      return $output;
    }
    $deposit_id = $deposition['id'];
    $doi = $deposition['metadata']['prereserve_doi']['doi'] ?? '';
    if (empty($doi) || empty($deposit_id)) {
      return '';
    }
    $title = t('Zenodo Deposition #@deposit_id @doi',
      [
        '@deposit_id' => $deposit_id,
        '@doi' => (empty($doi) ? '' : '( ' . $doi . ' )'),
      ]
    );
    // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
    $output .= '<h3>' . $title . '</h3>';
    switch ($format) {
      case 'dump':
        $dump = tpps_array_dump($deposition);
        foreach ($dump as $item) {
          $output .= '<h4>' . $item['title'] . '</h4>' . $item['data'];
        }
        break;

      case 'table':
      case 'table_row':
        // Returns single row of the table.
        $row = [];
        $array_item_list = ['metadata', 'links', 'files'];
        // Items from 'metadata'.
        $doi = $deposition['metadata']['prereserve_doi']['doi'] ?? '';
        $row['doi'] = empty($doi) ? '' : l($doi,
          'admin/reports/tpps/zenodo-depositions/' . $deposition['id']
        );
        foreach ($deposition as $key => $value) {
          if (in_array($key, $array_item_list)) {
            continue;
          }
          switch ($key) {

            case 'id':
              $value = l($value, 'admin/reports/tpps/zenodo-depositions/' . $value);
              break;

            case 'created':
            case 'modified':
              $value = str_replace('T', ' ', $value);
              break;

            default:
              $value = (string) $value;
              break;
          }
          $row[$key] = $value;
        }
        if ($format == 'table') {
          $output = theme('table', [
            'header' => array_keys($row),
            'rows' => [$row],
          ]);
        }
        else {
          $output = $row;
        }

        break;

      case 'list':
      default:
        $output .= tpps_array_print_list($deposition);
        break;
    }
    return $output;
  }

  /**
   * Prints out multiple Zenodo Depositions using HTML-list.
   *
   * @param array $list
   *   List of the Zenodo Depositions.
   *   See ZenodoDeposit::list().
   * @param string $format
   *   Output format. Possible values are: 'table' and 'list' (default).
   *
   * @return string
   *   Returns rendered HTML-list of all depositions.
   */
  public static function printDepositionList(array $list, $format = 'list') {
    $output = '';
    $rows = [];
    foreach ($list as $deposition) {
      if ($format == 'table') {
        $rows[] = static::printDeposition($deposition, 'table_row');
      }
      else {
        $output .= static::printDeposition($deposition, $format);
      }
    }
    if ($format == 'table') {
      $output .= theme('table', [
        'header' => array_keys($rows[0]),
        'rows' => $rows,
      ]);
    }
    return $output;
  }

  /**
   * Checks if response contains single Deposition.
   *
   * @param array $response
   *   Zenodo API response.
   *
   * @return bool
   *   Returns TRUE if response has Deposition entity.
   *   Returns FALSE and shows error message on page if Deposition not found.
   */
  public static function isDeposition(array $response) {
    if (empty($response['id']) && empty($response['metadata'])) {
      if (!empty($response['status']) && !empty($response['message'])) {
        drupal_set_message(t('ZenodoDeposit Resource validation failed. '
          . '<br />Response: <strong>@code - @message</strong>'
          . '<br />Check if correct Zenodo server was used. '
          . 'Current sever: <strong>@server</strong>.'
          . '<br />To change server use !settings_page_link.',
          [
            '@code' => $response['status'],
            '@message' => $response['message'],
            '@server' => ZenodoDeposit::isSandboxServer() ? 'Sandbox' : 'LIVE',
            '!settings_page_link' => l(t('Zenodo Settings page'),
            'admin/config/tpps/zenodo'),
          ])
        );
      }
      else {
        drupal_set_message(t('Zenodo Depostion not found.'));
      }
      return FALSE;
    }
    return TRUE;
  }

  /**
   * Formats an author name for Zenodo metadata fields.
   *
   * Former: tpps_doi_format_name($name).
   *
   * @param string $name
   *   The name to format.
   *
   * @return string
   *   The formatted name.
   */
  public static function formatAuthorName($name) {
    $parts = explode(' ', $name);
    $first = $parts[0];
    $last = implode(' ', array_slice($parts, 1));
    return "$last, $first";
  }

}
