<?php

/**
 * @file
 * Contains 'Zenodo' class.
 *
 * Example of the DOI generated by Zenodo: 10.5281/zenodo.14918129.
 *
 * Introduction
 * The Zenodo REST API currently supports:
 *    Deposit — upload and publishing of research outputs (identical to
 *      functionality available in the user interface).
 *    Records — search published records.
 *    Files — download/upload of files.
 *
 * The following REST APIs are currently in testing before we launch them
 * in beta with full documentation:
 *
 *    Communities - search communities.
 *    Funders — search for funders.
 *    Grants — search for grants.
 *    Licenses — search for licenses.
 *
 * You can have a sneak peek at the APIs in test from our root endpoint:
 * https://zenodo.org/api/
 *
 * @todo Minor. Implement alter-hooks for ZenodoDeposit Actions.
 */

/**
 * Manages requests to Zenodo API.
 *
 * @package tpps
 * @author Vlad Savitsky <vlad.savitsky@gmail.com>
 */
class ZenodoDeposit extends Zenodo {

  // Prefix of the API URL.
  const BASE_PATH = '/api/deposit/depositions';

  // Zenodo Depositon States.
  // Seems it's for not yet submitted depositions ('submitted' == FALSE).
  // See https://developers.zenodo.org/#representation
  const STATE_INPRPOGRESS = 'inprogress';
  const STATE_DONE = 'done';
  const STATE_ERROR = 'error';
  // State 'unsubmitted' wan't listed in docs but new depositions has it.
  const STATE_UNSUBMITTED = 'unsubmitted';

  const E_NOT_FOUND = 'Zenodo Deposit was not found.';
  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // API scope: deposit:actions.

  /**
   * Publish a deposition.
   *
   * Scope (permissions): deposit:actions.
   * Note, once a deposition is published, you can no longer delete it.
   * See: https://developers.zenodo.org/?shell#publish.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *
   * @return mixed
   *   Returns API response.
   */
  public static function publish(array $data) {
    $data['payload'] = $data['payload'] ?? [];
    $data['action'] = 'publish';

    // Call all implementations of hooks:
    // - hook_zenodo_deposit_publish_alter(),
    drupal_alter(static::getHookName(__FUNCTION__), $data);

    $data['url'] = static::buildActionUrl($data);
    $data['response'] = RestAPI::post($data['url'], $data['payload']);

    if (function_exists('module_invoke_all')) {
      module_invoke_all(static::getHookName('published'), $data);
    }
    return $data['response'];
  }

  /**
   * Unlock already submitted deposition for editing.
   *
   * Scope (permissions): deposit:actions.
   * See: https://developers.zenodo.org/?shell#edit.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *
   * @return mixed
   *   Returns API response.
   */
  public static function edit(array $data) {
    $data['action'] = 'edit';

    // Call all implementations of hooks:
    // - hook_zenodo_deposit_edit_alter(),
    drupal_alter(static::getHookName(__FUNCTION__), $data);

    $data['url'] = static::buildActionUrl($data);
    $data['response'] = RestAPI::post($data['url']);

    if (function_exists('module_invoke_all')) {
      module_invoke_all(static::getHookName('edited'), $data, $response);
    }
    return $data['response'];
  }

  /**
   * Discard changes in the current editing session.
   *
   * Scope (permissions): deposit:actions.
   * See: https://developers.zenodo.org/?shell#discard.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *
   * @return mixed
   *   Returns API response.
   */
  public static function discard(array $data) {
    $data['action'] = 'discard';
    $data['payload'] = $data['payload'] ?? [];
    // Call all implementations of hooks:
    // - hook_zenodo_deposit_discard_alter(),
    drupal_alter(static::getHookName(__FUNCTION__), $data);

    $data['url'] = static::buildActionUrl($data);
    $data['response'] = RestAPI::post($data['url'], $data['payload']);

    if (function_exists('module_invoke_all')) {
      module_invoke_all(static::getHookName('discarded'), $data);
    }
    return $data['response'];
  }

  /**
   * Create a new version of a deposition.
   *
   * Scope (permissions): deposit:actions.
   *
   * See: https://developers.zenodo.org/?shell#new-version.
   *
   * This action will create a new deposit, which will be a snapshot of the
   * current resouce, inheriting the metadata as well as snapshot of files.
   * The new version deposit will have a state similar to a new, unpublished
   * deposit, most importantly its files will be modifiable as for a new deposit.
   *
   * Only one unpublished new version deposit can be available at any moment,
   * i.e.: calling new version action multiple times will have no effect,
   * as long as the resulting new version deposit from the first call is not
   * published or deleted.
   *
   * NOTES:
   * - The response body of this action is NOT the new version deposit,
   *   but the original resource. The new version deposition can be accessed
   *   through the "latest_draft" under "links" in the response body.
   * - The id used to create this new version has to be the id of the latest
   *   version. It is not possible to use the global id that references all
   *   the versions.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *
   * @return mixed
   *   Returns API response.
   */
  public static function newVersion(array $data) {
    $data['action'] = 'newversion';

    // Call all implementations of hooks:
    // - hook_zenodo_deposit_new_version_alter(),
    drupal_alter(static::getHookName('new_version'), $data);

    $data['url'] = static::buildActionUrl($data);
    $data['response'] = RestAPI::post($data['url']);

    if (function_exists('module_invoke_all')) {
      module_invoke_all(static::getHookName('new_version_created'), $data);
    }
    return $data['response'];
  }

  /**
   * Builds API Endpoint for Action-commands.
   *
   * @param array $data
   *   Data for requiest. Required keys are:
   *   'deposit_id' - int. Zenodo Deposition Id.
   *   'action' - string. Name of the action.
   *
   * @return string
   *   Returns absolute URL for Zenodo API Endpoint.
   */
  public static function buildActionUrl(array $data) {
    self::validateRequired(['deposit_id', 'action'], $data);
    return static::buildUrl($data);
  }

  /**
   * Gets list of implemented Zenodo Deposition Actions.
   *
   * See https://developers.zenodo.org/?python#deposition-actions for details.
   *
   * @return array
   *   Returns list of actions.
   */
  public static function getActionList() {
    return [
      'edit', 'publish', 'newversion', 'discard'
    ];
  }

  // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
  // Different representations of the Zenodo Deposition Entity.

  /**
   * Prints single Deposition as a HTML-list.
   *
   * @param array $deposition
   *   Zenodo Deposition Enitiy.
   * @param string $format
   *   Output format. Possible values are: 'table' and 'list' (default).
   *
   * @return string
   *   Returns rendered HTML representation of the Deposition Entity.
   */
  public static function printDeposition(array $deposition, $format = 'list') {
    $output = '';
    if (
      !ZenodoDeposit::isDeposition($deposition)
      || empty($deposit_id = $deposition['id'])
    ) {
      return $output;
    }
    // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
    $host = (static::getHost() == self::LIVE_HOST ? 'live' : 'sandbox');
    $report_path = 'admin/reports/tpps/zenodo-depositions/' . $host . '/';
    switch ($format) {
      case 'dump':
        $dump = tpps_array_dump($deposition);
        foreach ($dump as $item) {
          $output .= '<h4>' . $item['title'] . '</h4>' . $item['data'];
        }
        break;

      case 'table':
      case 'table_row':
        // Returns single row of the table.
        $row = [];
        // Items from 'metadata' first.
        $row['host'] = strtoupper($host);
        $doi = $deposition['metadata']['prereserve_doi']['doi'] ?? '';
        $row['doi'] = $doi ? l($doi, $report_path . $deposition['id']) : '';

        foreach ($deposition as $key => $value) {
          $key = check_plain($key);
          if (!is_array($value)) {
            $value = check_plain($value);
          }
          switch ($key) {
            case 'metadata':
            case 'links':
              // Do not show huge arrays.
              $value = NULL;
              break;

            case 'files':
              $value = empty($value) ? t('[Empty]') : t('[NOT empty]');
              break;

            case 'id':
              $value = l($value, $report_path . $value);
              break;

            case 'created':
            case 'modified':
              $value = str_replace('T', ' ', $value);
              break;

            default:
              if (is_array($value)) {
                // @TODO Check_plain.
                $value = tpps_array_print_list($value);
              }
              else {
                $value = (string) $value;
              }
              break;
          }
          if (!is_null($value)) {
            $row[$key] = $value;
          }
        }
        if ($format == 'table') {
          $output = theme('table', [
            'header' => array_keys($row),
            'rows' => [$row],
          ]);
        }
        else {
          $output = $row;
        }
        break;

      case 'list':
      default:
        $output .= tpps_array_print_list($deposition);
        break;
    }
    return $output;
  }

  /**
   * Prints out multiple Zenodo Depositions using HTML-list.
   *
   * @param array $list
   *   List of the Zenodo Depositions.
   *   See ZenodoDeposit::list().
   * @param string $format
   *   Output format. Possible values are: 'table' and 'list' (default).
   *
   * @return string
   *   Returns rendered HTML-list of all depositions.
   */
  public static function printDepositionList(array $list, $format = 'list') {
    $output = '';
    $rows = [];
    foreach ($list as $deposition) {
      if ($format == 'table') {
        $rows[] = static::printDeposition($deposition, 'table_row');
      }
      else {
        $deposit_id = $deposition['id'];
        $doi = $deposition['metadata']['prereserve_doi']['doi'] ?? '';
        if (empty($doi) || empty($deposit_id)) {
          return '';
        }
        $title = t('Zenodo Deposition #@deposit_id @doi',
          [
            '@deposit_id' => $deposit_id,
            '@doi' => (empty($doi) ? '' : '( ' . $doi . ' )'),
          ]
        );
        $output .= '<h3>' . $title . '</h3>';
        $output .= static::printDeposition($deposition, $format);
      }
    }
    if ($format == 'table') {
      $output .= theme('table', [
        'header' => array_keys($rows[0]),
        'rows' => $rows,
      ]);
    }
    return $output;
  }

  /**
   * Checks if response contains single Deposition.
   *
   * @param array $response
   *   Zenodo API response.
   *
   * @return bool
   *   Returns TRUE if response has Deposition entity.
   *   Returns FALSE and shows error message on page if Deposition not found.
   */
  public static function isDeposition(array $response) {
    if (empty($response['id']) && empty($response['metadata'])) {
      if (function_exists('module_invoke_all')) {
        // For search purpuses:
        // tpps_zenodo_deposit_validation_failed().
        module_invoke_all(static::getHookName('validation_failed'), $response);
      }
      return FALSE;
    }
    return TRUE;
  }

  /**
   * Formats an author name for Zenodo metadata fields.
   *
   * Former: tpps_doi_format_name($name).
   *
   * @param string $name
   *   The name to format.
   *
   * @return string
   *   The formatted name.
   */
  public static function formatAuthorName($name) {
    $parts = explode(' ', $name);
    $first = $parts[0];
    $last = implode(' ', array_slice($parts, 1));
    return "$last, $first";
  }

  /**
   * Validate if Deposit Id belings to current Zenodo Host.
   *
   * There is a problem when 'ZenodoFile' class gets files by Deposit Id
   * created on other Zenodo Host by other account and having this files at
   * out pages is confusing.
   *
   * Note: Zenodo Files can't validate host because Zenodo allows to get
   * files data without any access token (files data are public). But only
   * Deposition data is accessible by owner.
   *
   * Note: This method throws an exception.
   *
   * @param array $data
   *   Data for ZenodoDeposit::retrieve() request.
   *   Required key is 'deposit_id'.
   *
   */
  public static function isHostValid(array $data) {
    try {
      $response = static::retrieve($data);
    }
    catch (Exception $e) {
      // In case of any errors assume that host is invalid.
      return FALSE;
    }
    return TRUE;
  }

  /**
   * Adds Zenodo Deposit widget to the form.
   *
   * Widget has an action-buttons and Zenodo Depositon object dump or links
   * to Zenodo Page.
   *
   * Usage example:
   * // Zenodo Deposition Widget.
   * $context = [
   *   'form' => &$form,
   *   'accession' => $accession,
   *   'zenodo_page_path' => $path . '/' . $accession . '/zenodo',
   *   'files_page_path' => $path . '/' . $accession . '/zenodo/files',
   *   'show_deposition_dump' => FALSE,
   *   'show_deposition_links' => FALSE,
   * ];
   * ZenodoDeposit::addWidget($context);
   *
   * @param array $context
   *   Data which is required to build widget.
   *   Required keys are:
   *   'form' - array. Drupal Form array.
   *   'accession' - string. TPPS Submission accession. E.g., 'TGDRxxxx'.
   */
  public static function addWidget(array $context) {
    // Defines if links from Zenodo Deposition Object be shown.
    $show_deposition_links = $context['show_deposition_links'] ?? FALSE;

    if (empty($accession = $context['accession'])) {
      drupal_set_message(
        t('Empty study accession. Please choose one from the list below.'),
        'error'
      );
      return;
    }
    $form = &$context['form'] ?? NULL;
    if (is_null($form)) {
      drupal_set_message(t('Zenodo Deposition Widget requres form.'), 'error');
      return;
    }

    // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
    // Widget container and hidden fields.
    $form['zenodo_deposition'] = $form['zenodo_deposition'] ?? [
      '#type' => 'container',
      '#tree' => TRUE,
      // Store Submission Accession and Zenodo Deposit Id.
      'accession' => ['#type' => 'hidden', '#value' => $accession],
      'zenodo_page_path' => [
        '#type' => 'hidden',
        '#value' => $context['zenodo_page_path'] ?? NULL,
      ],
      'files_page_path' => [
        '#type' => 'hidden',
        '#value' => $context['files_page_path'] ?? NULL,
      ],
    ];
    $zenodo_widget = &$form['zenodo_deposition'];

    // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
    // Get Zenodo Deposition.
    if (!empty($context['$deposition'])) {
      // Zenodo Deposition was already loaded.
      // @TODO Validate array.
      $deposition = $context['$deposition'];
    }
    else {
      // Use Zenodo API.
      if (empty($accession)) {
        drupal_set_message(t('Empty acession. Please choose one from the list below.'), 'error');
        if ($context['zenodo_page_path']) {
          drupal_goto($context['zenodo_page_path']);
        }
      }
      //tpps_submission_list_validate_accession($accession);
      $submission = new Submission($accession);

      // Check if submission exists.
      $deposit_id = $submission->getZenodoDepositId();

      // Get Zenodo Deposition.
      if ($deposit_id) {
        $zenodo_widget[$deposit_id] = [
          '#type' => 'fieldset',
          '#title' => t('Zenodo Deposit Id: @id', ['@id' => $deposit_id]),
        ];
        $data['deposit_id'] = $deposit_id;
        try {
          if (variable_get('tpps_zenodo_host_greedy_search', FALSE)) {
            static::searchHost($data);
          }
          $deposition = ZenodoDeposit::retrieve($data);
          if (!empty($context['show_deposition_dump'])) {
            // Show Deposition Dump.
            $output = $deposition;
            if (is_array($deposition)) {
              $output = ZenodoDeposit::printDeposition($deposition);
            }
            $zenodo_widget[$deposit_id]['dump'] = [
              '#markup' => ZenodoDeposit::getHostStatus() . '<br />' . $output,
            ];
          }
          else {
            // Only a few links.
            $items = [
              ZenodoDeposit::getHostStatus(),
              l(t('Zenodo Deposition'),
                'tpps/submission/' . $accession . '/zenodo'
              ),
              l(t('Zenodo Deposition Files'),
                'tpps/submission/' . $accession . '/zenodo/files'
              ),
            ];
            if ($show_deposition_links ?? FALSE) {
              $zenodo_links = [];
              foreach ($deposition['links'] as $name => $url) {
                if (in_array($name, ['html', 'badge', 'latest_draft_html'])) {
                  $zenodo_links[] = l($name, $url);
                }
                else {
                  $zenodo_links[] = l($name, Zenodo::addAccessToken($url));
                }
              }
              $items = array_merge($items, $zenodo_links);
            }
            $zenodo_widget[$deposit_id]['links'] = [
              '#markup' => theme('item_list', ['items' => $items]),
            ];
          }
        }
        catch (Exception $e) {
          if (in_array($e->getCode(), [403, 404])) {
            $deposition = NULL;
            $message = t('Submission has Deposit Id (#@deposit_id) but it was NOT '
              . 'found on any Zenodo Host. Options: !option_list',
              [
                '@deposit_id' => $deposit_id,
                '!option_list' => theme('item_list', [
                  'items' => [
                    'Create new Deposition to overwrite existing Deposit Id.',
                    'Create and remove to unset Deposit Id.',
                  ]
                ]),
              ]
            );
            drupal_set_message($message, 'error');
          }
          // @TODO Idea: Switch to other host and retrieve deposition again.
          $zenodo_widget[$deposit_id]['dump'] = [
            '#markup' => t('No Depostion found.'),
          ];
        }
      }
      else {
        $zenodo_widget['message'] = [
          '#markup' => theme('item_list', [
            'items' => [
               ZenodoDeposit::getHostStatus(),
               t("Submission doesn't have Zenodo Deposition."),
            ]
          ]),
        ];
      }
    }
    // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
    $zenodo_widget['id'] = [
      '#type' => 'hidden',
      '#value' => $deposit_id ?? NULL,
    ];
    // ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
    // Show buttons.
    $action_list = ['create'];
    if (!empty($deposition)) {
      $action_list = [
        'update', 'delete',
        'publish', 'newversion',
        // @TODO Minor. Buttons which must be shown in certain conditions.
        // 'discard', 'edit',
      ];
    }
    // Add action-buttons in own container.
    $zenodo_widget['actions'] = ['#type' => 'container'];
    foreach ($action_list as $key) {
      // Show only 'Create' button if there is no Zenodo Deposition and
      // don't show 'Create' Button when Depositon exists.
      if (
        // Hide 'Edit' button for not yet submitted Depositions.
        !empty($deposition['id']) && $key == 'edit' && empty($deposition['submitted'])
      ) {
        continue;
      }
      $zenodo_widget['actions'][$key] = [
        '#type' => 'submit',
        '#name' => $key,
        '#value' => t(ucfirst(str_replace('_', ' ', $key))),
        // @todo Minor. Do we need also validator?
        '#submit' => ['ZenodoDeposit::widgetSubmit'],
      ];
    }
  }

  /**
   * Submitter for the Zenodo Deposit Widget.
   *
   * See ZenodoDeposit::addWidget().
   *
   * @param array $form
   *   Drupal Form array.
   * @param array $form_state
   *   Drupal Form State array.
   */
  public static function widgetSubmit(array $form, array $form_state) {
    $zenodo_widget = $form_state['values']['zenodo_deposition'];

    $files_page_path = $zenodo_widget['files_page_path'] ?? NULL;
    $zenodo_page_path = $zenodo_widget['zenodo_page_path'] ?? NULL;
    $accession = $zenodo_widget['accession'] ?? '';
    $action = $form_state['triggering_element']['#name'];

    $data = [];
    $data['accession'] = $accession;

    $submission = new Submission($accession);
    $deposit_id = $submission->getZenodoDepositId();
    $path = $form_state['zenodo_deposition']['path'] ?? 'tpps/submission';
    // Validate Deposit Id here intead of orm validator because it will be used
    // here and full load of the Submission object takes a lot of time.
    if (empty($deposit_id)) {
      if (!in_array($action, ['create', 'list', 'files'])) {
        $message = t('Submission has no Zenodo Deposit Id. Create Zenodo Deposition first.');
        drupal_set_message($message, 'error');
        if ($zenodo_page_path) {
          drupal_goto($zenodo_page_path);
        }
      }
    }
    else {
      $data['deposit_id'] = $deposit_id;
    }
    // Files has a subpage.
    if ($action == 'files' && !empty($files_page_path)) {
      drupal_get_messages();
      if ($files_page_path) {
        drupal_goto($files_page_path);
      }
    }
    // Validate $action.
    $class = 'ZenodoDeposit';
    $method_name = $class . '::' . $action;
    if (!is_callable($method_name, TRUE)) {
      drupal_set_message(t('Attempt to call non-existing Zenodo API action: @name.',
        ['@name' => $method_name]), 'error'
      );
      if ($zenodo_page_path) {
        drupal_goto($zenodo_page_path);
      }
    }
    // Get response.
    call_user_func($method_name, $data);
  }

}
